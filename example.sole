import core


def fibonacci(n: int64) -> int64:
    """TODO: Document this function."""
    if n < 2:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)


def main() -> int32:
    """TODO: Document this function."""
    n: int64 = 40
    result: int64 = fibonacci(n)

    core.print("Recursive Fibonacci benchmark")
    core.print("n:")
    core.print(n)
    core.print("Result:")
    core.print(result)

    if result != 102334155:
        core.print("Unexpected result")
        return 1
    return 0
