import core
import runtime.system as system


def is_file(path: str) -> bool:
    """Return whether path resolves to a regular file, following symlinks."""
    return system.is_file(core.cstr(path))


def realpath(path: str) -> str:
    """Return the canonical absolute path, exiting with an error if resolution fails."""
    return core.from_cstr(system.realpath(core.cstr(path)))


def same_file(first: str, second: str) -> bool:
    """Return whether both paths identify the same file, or false if either cannot be resolved."""
    return system.same_file(core.cstr(first), core.cstr(second))
