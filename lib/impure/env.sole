import core
import wrappers.libc


def get(name: str, fallback: str) -> str:
    value: ptr = wrappers.libc.getenv(core.cstr(name))
    if value == ptr(0):
        return fallback
    return core.from_cstr(value)


def has(name: str) -> bool:
    return wrappers.libc.getenv(core.cstr(name)) != ptr(0)
