import core


def bisect_left(a: int64[], x: int64) -> int64:
    """TODO: Document this function."""
    lo: int64 = 0
    hi: int64 = core.len(a)
    while lo < hi:
        mid: int64 = lo + (hi - lo) / 2
        if a[mid] < x:
            lo = mid + 1
        else:
            hi = mid
    return lo


def bisect_right(a: int64[], x: int64) -> int64:
    """TODO: Document this function."""
    lo: int64 = 0
    hi: int64 = core.len(a)
    while lo < hi:
        mid: int64 = lo + (hi - lo) / 2
        if x < a[mid]:
            hi = mid
        else:
            lo = mid + 1
    return lo


def bisect(a: int64[], x: int64) -> int64:
    """TODO: Document this function."""
    return bisect_right(a, x)


def _insert(a: int64[], x: int64, index: int64) -> void:
    """TODO: Document this function."""
    core.append(a, x)
    i: int64 = core.len(a) - 1
    while i > index:
        a[i] = a[i - 1]
        i = i - 1
    a[index] = x


def insort_left(a: int64[], x: int64) -> void:
    """TODO: Document this function."""
    _insert(a, x, bisect_left(a, x))


def insort_right(a: int64[], x: int64) -> void:
    """TODO: Document this function."""
    _insert(a, x, bisect_right(a, x))


def insort(a: int64[], x: int64) -> void:
    """TODO: Document this function."""
    insort_right(a, x)
