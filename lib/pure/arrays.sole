import core


def index_of(items: str[], value: str) -> int64:
    """Return the first matching string index, or -1 if absent."""
    for i in range(core.len(items)):
        if items[i] == value:
            return i
    return -1


def contains(items: str[], value: str) -> bool:
    """Return whether the string array contains value."""
    return index_of(items, value) >= 0
