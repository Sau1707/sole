import core


def split(path: str) -> str[]:
    """Return [directory, basename], retaining the directory's trailing slash without normalization."""
    i: int64 = core.len(path)
    while i > 0 && core.slice(path, i - 1, i) != "/":
        i = i - 1
    return [core.slice(path, 0, i), core.slice(path, i, core.len(path))]


def replace_suffix(path: str, suffix: str, replacement: str) -> str:
    """Replace a nonempty byte suffix only after a nonempty prefix; otherwise append replacement."""
    if suffix != "" && core.len(path) > core.len(suffix) && path.ends_with(suffix):
        return core.slice(path, 0, core.len(path) - core.len(suffix)) + replacement
    return path + replacement


def isabs(path: str) -> bool:
    """TODO: Document this function."""
    return path.starts_with("/")


def join(a: str, b: str) -> str:
    """TODO: Document this function."""
    if isabs(b) || core.len(a) == 0:
        return b
    if a.ends_with("/"):
        return a + b
    return a + "/" + b


def basename(path: str) -> str:
    """TODO: Document this function."""
    parts: str[] = split(path)
    return parts[1]


def dirname(path: str) -> str:
    """TODO: Document this function."""
    parts: str[] = split(path)
    directory: str = parts[0]
    end: int64 = core.len(directory)
    while end > 0 && core.slice(directory, end - 1, end) == "/":
        end = end - 1
    if end == 0:
        return directory
    return core.slice(directory, 0, end)


def normpath(path: str) -> str:
    """TODO: Document this function."""
    prefix: str = ""
    if isabs(path):
        prefix = "/"
        if core.len(path) >= 2 && core.slice(path, 0, 2) == "//":
            if core.len(path) == 2 || core.slice(path, 2, 3) != "/":
                prefix = "//"
    parts: str[] = []
    count: int64 = 0
    start: int64 = 0
    for i in range(core.len(path) + 1):
        if i == core.len(path) || core.slice(path, i, i + 1) == "/":
            part: str = core.slice(path, start, i)
            if part != "" && part != ".":
                if part == ".." && count > 0 && parts[count - 1] != "..":
                    count = count - 1
                elif part != ".." || prefix == "":
                    if count == core.len(parts):
                        core.append(parts, part)
                    else:
                        parts[count] = part
                    count = count + 1
            start = i + 1
    fragments: str[] = [prefix]
    for i in range(count):
        if i > 0:
            core.append(fragments, "/")
        core.append(fragments, parts[i])
    result: str = core.join(fragments)
    if result == "":
        return "."
    return result
