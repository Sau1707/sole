def is_digit(byte: uint8) -> bool:
    """TODO: Document this function."""
    return byte >= 48 && byte <= 57


def is_alpha(byte: uint8) -> bool:
    """TODO: Document this function."""
    return byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122


def is_space(byte: uint8) -> bool:
    """TODO: Document this function."""
    return byte == 32 || byte >= 9 && byte <= 13


def to_lower(byte: uint8) -> uint8:
    """TODO: Document this function."""
    if byte >= 65 && byte <= 90:
        return byte + 32
    return byte


def to_upper(byte: uint8) -> uint8:
    """TODO: Document this function."""
    if byte >= 97 && byte <= 122:
        return byte - 32
    return byte
