
# Create, parse, verify, and release LLVM contexts and modules.
extern def LLVMContextCreate() -> ptr


extern def LLVMCreateMemoryBufferWithMemoryRangeCopy(data: ptr, size: uint64, name: ptr) -> ptr


extern def LLVMParseIRInContext(context: ptr, buffer: ptr, module_out: ptr, error_out: ptr) -> int32


extern def LLVMVerifyModule(module: ptr, action: int32, error_out: ptr) -> int32


extern def LLVMDisposeMessage(message: ptr) -> void


extern def LLVMDisposeModule(module: ptr) -> void


extern def LLVMContextDispose(context: ptr) -> void


# Register the native x86 target and assembly emitter.
extern def LLVMInitializeX86TargetInfo() -> void


extern def LLVMInitializeX86Target() -> void


extern def LLVMInitializeX86TargetMC() -> void


extern def LLVMInitializeX86AsmPrinter() -> void


# Select a target machine and configure its data layout.
extern def LLVMGetDefaultTargetTriple() -> ptr


extern def LLVMGetTargetFromTriple(triple: ptr, target_out: ptr, error_out: ptr) -> int32


extern def LLVMCreateTargetMachine(target: ptr, triple: ptr, cpu: ptr, features: ptr, level: int32, reloc: int32, model: int32) -> ptr


extern def LLVMSetTarget(module: ptr, triple: ptr) -> void


extern def LLVMCreateTargetDataLayout(machine: ptr) -> ptr


extern def LLVMCopyStringRepOfTargetData(layout: ptr) -> ptr


extern def LLVMSetDataLayout(module: ptr, layout: ptr) -> void


extern def LLVMDisposeTargetData(layout: ptr) -> void


# Emit native object files and release target machines.
extern def LLVMTargetMachineEmitToFile(machine: ptr, module: ptr, filename: ptr, kind: int32, error_out: ptr) -> int32


extern def LLVMDisposeTargetMachine(machine: ptr) -> void


# Run optimization passes and manage their options and error messages.
extern def LLVMRunPasses(module: ptr, passes: ptr, machine: ptr, options: ptr) -> ptr


extern def LLVMCreatePassBuilderOptions() -> ptr


extern def LLVMDisposePassBuilderOptions(options: ptr) -> void


extern def LLVMGetErrorMessage(error: ptr) -> ptr


extern def LLVMDisposeErrorMessage(message: ptr) -> void
