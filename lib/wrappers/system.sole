
# Locate compiler resources and the standard library.
extern def sole_rt_home() -> ptr


extern def sole_rt_lib_home() -> ptr


# Resolve filesystem paths and identify regular files.
extern def sole_rt_realpath(path: ptr) -> ptr


extern def sole_rt_is_file(path: ptr) -> int32


# Inspect native floating-point bits.
extern def sole_rt_f64_bits(value: float64) -> uint64


# Manage temporary outputs and protect source files from overwrites.
extern def sole_rt_temp_dir() -> ptr


extern def sole_rt_output_dir(output: ptr) -> ptr


extern def sole_rt_output_path(output: ptr) -> ptr


# Return null on success, otherwise a borrowed error message.
extern def sole_rt_atomic_write_file(path: ptr, data: ptr, length: int64) -> ptr


extern def sole_rt_same_file(first: ptr, second: ptr) -> int32


extern def sole_rt_process_run(executable: ptr, arguments: ptr, status: ptr) -> int32
