import types.definition
import types.int8
import types.int16
import types.int32
import types.int64
import types.uint8
import types.uint16
import types.uint32
import types.uint64
import types.float32
import types.float64
import types.bool
import types.str
import types.ptr
import types.void


def lookup(name: str) -> types.definition.Type:
    if name == "int8":
        return types.int8.int8().definition()
    if name == "int16":
        return types.int16.int16().definition()
    if name == "int32":
        return types.int32.int32().definition()
    if name == "int64":
        return types.int64.int64().definition()
    if name == "uint8":
        return types.uint8.uint8().definition()
    if name == "uint16":
        return types.uint16.uint16().definition()
    if name == "uint32":
        return types.uint32.uint32().definition()
    if name == "uint64":
        return types.uint64.uint64().definition()
    if name == "float32":
        return types.float32.float32().definition()
    if name == "float64":
        return types.float64.float64().definition()
    if name == "bool":
        return types.bool.bool().definition()
    if name == "str":
        return types.str.str().definition()
    if name == "ptr":
        return types.ptr.ptr().definition()
    if name == "void":
        return types.void.void().definition()
    return types.definition.Type(name, "", 0, "", false)
