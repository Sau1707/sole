class Type:
    name: str
    llvm: str
    bits: int64
    category: str
    unsigned: bool

    def integer(self) -> bool:
        return self.category == "integer"

    def floating(self) -> bool:
        return self.category == "float"

    def numeric(self) -> bool:
        return self.integer() || self.floating()

    def arithmetic(self, operator: str) -> str:
        if not self.numeric():
            return ""
        if self.floating():
            if operator == "+":
                return "fadd"
            if operator == "-":
                return "fsub"
            if operator == "*":
                return "fmul"
            if operator == "/":
                return "fdiv"
            if operator == "%":
                return "frem"
            return ""
        if operator == "+":
            return "add"
        if operator == "-":
            return "sub"
        if operator == "*":
            return "mul"
        if operator == "/":
            if self.unsigned:
                return "udiv"
            return "sdiv"
        if operator == "%":
            if self.unsigned:
                return "urem"
            return "srem"
        if operator == "&":
            return "and"
        if operator == "|":
            return "or"
        if operator == "^":
            return "xor"
        if operator == "<<":
            return "shl"
        if operator == ">>":
            if self.unsigned:
                return "lshr"
            return "ashr"
        return ""

    def comparison(self, operator: str) -> str:
        predicate: str = ""
        if operator == "==":
            predicate = "eq"
        elif operator == "!=":
            predicate = "ne"
        elif operator == "<":
            predicate = "lt"
        elif operator == "<=":
            predicate = "le"
        elif operator == ">":
            predicate = "gt"
        elif operator == ">=":
            predicate = "ge"
        else:
            return ""
        if self.floating():
            if operator == "!=":
                return "fcmp une"
            return "fcmp o" + predicate
        if operator == "==" || operator == "!=":
            if self.integer() || self.category == "bool" || self.category == "ptr":
                return "icmp " + predicate
            return ""
        if not self.integer():
            return ""
        if self.unsigned:
            return "icmp u" + predicate
        return "icmp s" + predicate

    def conversion(self, destination: Type) -> str:
        if self.name == destination.name:
            return "identity"
        if self.category == "ptr" && destination.integer():
            return "ptrtoint"
        if self.integer() && destination.category == "ptr":
            return "inttoptr"
        if destination.category == "bool":
            if self.floating():
                return "fcmp une"
            if self.integer():
                return "icmp ne"
        if self.integer() || self.category == "bool":
            if destination.integer():
                if self.bits == destination.bits:
                    return "identity"
                if self.bits > destination.bits:
                    return "trunc"
                if self.unsigned || self.category == "bool":
                    return "zext"
                return "sext"
            if destination.floating():
                if self.unsigned || self.category == "bool":
                    return "uitofp"
                return "sitofp"
        if self.floating():
            if destination.integer():
                if destination.unsigned:
                    return "fptoui"
                return "fptosi"
            if destination.floating():
                if self.bits > destination.bits:
                    return "fptrunc"
                return "fpext"
        return ""

    def maximum(self, negative: bool) -> uint64:
        if not self.unsigned:
            limit: uint64 = uint64(1) << uint64(self.bits - 1)
            if not negative:
                limit = limit - 1
            return limit
        if self.bits < 64:
            return (uint64(1) << uint64(self.bits)) - 1
        return uint64(18446744073709551615)

    def lower_bound(self) -> str:
        if self.unsigned:
            return "0"
        return "-" + str(uint64(1) << uint64(self.bits - 1))

    def upper_bound(self) -> str:
        if not self.unsigned:
            return str(uint64(1) << uint64(self.bits - 1))
        if self.bits == 64:
            return "18446744073709551616"
        return str(uint64(1) << uint64(self.bits))
