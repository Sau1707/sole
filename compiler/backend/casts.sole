import backend.ir
import backend.literals
import backend.types
import frontend.diagnostics
import frontend.model
import frontend.types


# Emit explicit numeric or pointer conversions with required range checks.
def cast_value(state: frontend.model.State, value: frontend.model.Value, destination: str) -> frontend.model.Value:
    # Resolve literal types before selecting a conversion instruction.
    if value.typ == "integer" or value.typ == "real":
        literal_context: str = ""
        if value.typ == "integer" and (frontend.types.integer_type(destination) or frontend.types.float_type(destination)) or value.typ == "real" and frontend.types.float_type(destination):
            literal_context = destination
        value = backend.literals.coerce(state, value, literal_context)
    source_type: str = value.typ
    if source_type == destination:
        return value
    source_ir: str = backend.types.llvm_type(state, source_type)
    dest_ir: str = backend.types.llvm_type(state, destination)
    operation: str = ""
    if source_type == "ptr" and frontend.types.integer_type(destination):
        operation = "ptrtoint"
    elif frontend.types.integer_type(source_type) and destination == "ptr":
        operation = "inttoptr"
    elif destination == "bool":
        if frontend.types.float_type(source_type):
            return frontend.model.Value("bool", backend.ir.instruction(state, "fcmp une " + backend.ir.typed(state, value) + ", 0.0"), "")
        if frontend.types.integer_type(source_type):
            return frontend.model.Value("bool", backend.ir.instruction(state, "icmp ne " + backend.ir.typed(state, value) + ", 0"), "")
    elif (frontend.types.integer_type(source_type) or source_type == "bool") and frontend.types.integer_type(destination):
        if frontend.types.width(source_type) == frontend.types.width(destination):
            return frontend.model.Value(destination, value.value, "")
        if frontend.types.width(source_type) > frontend.types.width(destination):
            operation = "trunc"
        elif frontend.types.unsigned_type(source_type) or source_type == "bool":
            operation = "zext"
        else:
            operation = "sext"
    elif (frontend.types.integer_type(source_type) or source_type == "bool") and frontend.types.float_type(destination):
        operation = "sitofp"
        if frontend.types.unsigned_type(source_type) or source_type == "bool":
            operation = "uitofp"
    elif frontend.types.float_type(source_type) and frontend.types.integer_type(destination):
        # Guard float-to-integer conversions against NaN and range overflow.
        bits: int64 = frontend.types.width(destination)
        low_text: str = "0"
        high_number: uint64 = uint64(1) << uint64(bits - 1)
        high_text: str = str(high_number)
        if frontend.types.unsigned_type(destination):
            if bits == 64:
                high_text = "18446744073709551616"
            else:
                high_text = str(uint64(1) << uint64(bits))
        else:
            low_text = "-" + high_text
        low_value: frontend.model.Value = backend.literals.float_literal(state, low_text, source_type)
        high_value: frontend.model.Value = backend.literals.float_literal(state, high_text, source_type)
        above: str = backend.ir.instruction(state, "fcmp oge " + backend.ir.typed(state, value) + ", " + low_value.value)
        below: str = backend.ir.instruction(state, "fcmp olt " + backend.ir.typed(state, value) + ", " + high_value.value)
        backend.ir.checked(state, backend.ir.instruction(state, "and i1 " + above + ", " + below))
        operation = "fptosi"
        if frontend.types.unsigned_type(destination):
            operation = "fptoui"
    elif frontend.types.float_type(source_type) and frontend.types.float_type(destination):
        operation = "fpext"
        if destination == "float32":
            operation = "fptrunc"
    if operation == "":
        frontend.diagnostics.fail_at(state, "cannot cast " + source_type + " to " + destination)
    return frontend.model.Value(destination, backend.ir.instruction(state, operation + " " + source_ir + " " + value.value + " to " + dest_ir), "")
