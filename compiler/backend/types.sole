import frontend.diagnostics
import frontend.model
import frontend.symbols
import frontend.types
import types.definition
import types.registry


# Map a Sole type to its LLVM representation and validate array sizes.
def llvm_type(state: frontend.model.State, typ: str) -> str:
    definition: types.definition.Type = types.registry.lookup(typ)
    if definition.llvm != "":
        return definition.llvm
    if frontend.types.dynamic_type(typ):
        element: str = frontend.types.element_type(typ)
        if element == "void":
            frontend.diagnostics.fail_at(state, "void cannot be an array element type")
        llvm_type(state, element)
        return "ptr"
    if frontend.types.array_type(typ):
        length: int64 = frontend.types.fixed_length(typ)
        if length < 1 || length > 1000000:
            frontend.diagnostics.fail_at(state, "array size must be between 1 and 1000000")
        return "[" + str(length) + " x " + llvm_type(state, frontend.types.element_type(typ)) + "]"
    idx: int64 = frontend.symbols.record_index(state, typ)
    if idx < 0:
        frontend.diagnostics.fail_at(state, "unknown type '" + typ + "'")
    if state.records[idx].kind == "class":
        return "ptr"
    return "%" + typ
