import core
import backend.ir
import backend.literals
import frontend.builtins
import frontend.diagnostics
import frontend.model
import frontend.symbols


# Validate a local name, allocate its storage, and initialize its value.
def declare_local(state: frontend.model.State, name: str, typ: str, value: frontend.model.Value) -> void:
    if frontend.symbols.local_index(state, name) >= 0:
        frontend.diagnostics.fail_at(state, "variable is already declared; shadowing is forbidden")
    if frontend.builtins.reserved_name(name) || frontend.symbols.record_index(state, name) >= 0 || frontend.symbols.sum_index(state, name) >= 0 || frontend.symbols.function_index(state, name) >= 0:
        frontend.diagnostics.fail_at(state, "reserved variable name '" + name + "'")
    if typ == "void":
        frontend.diagnostics.fail_at(state, "void is only a return type")
    value = backend.literals.coerce(state, value, typ)
    pointer: str = backend.ir.slot(state, typ)
    backend.ir.emit(state, "store " + backend.ir.typed(state, value) + ", ptr " + pointer)
    core.append(state.names, name)
    core.append(state.types, typ)
    core.append(state.pointers, pointer)
    core.append(state.depths, state.depth)
