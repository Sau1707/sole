import semantic.model as model
import syntax.lexer.tokens as token_model


struct LoopTargets:
    continue_target: str
    break_target: str


# Share declarations, local scopes, and emitted IR during compilation.
struct State:
    tokens: token_model.Tokens
    records: model.RecordInfo[]
    functions: model.FunctionInfo[]
    globals: str[]
    definitions: str[]
    code: str[]
    slots: str[]
    names: str[]
    types: str[]
    pointers: str[]
    depths: int32[]
    loops: LoopTargets[]
    # Single-element arrays share mutable cells across struct copies.
    serial: int64[]
    depth: int32[]
    ended: bool[]
    result: str
    filename: str
    loop_depth: int64[]
    function_name: str


def fresh(state: State) -> str:
    """Allocate a name using the shared counter cell."""
    state.serial[0] = state.serial[0] + 1
    return "v" + str(state.serial[0])


# Carry an expression's type, LLVM value, and optional storage address.
struct Value:
    typ: str
    value: str
    pointer: str


struct Expression:
    value: Value
    is_call: bool
