import core
import codegen.llvm.ir as ir
import codegen.llvm.context as context
import codegen.llvm.literals as literals
import diagnostics.report as diagnostics
import semantic.resolve.symbols as symbols
import semantic.resolve.builtins as builtins


def declare_local(state: context.State, name: str, typ: str, value: context.Value) -> void:
    """Validate a local name, allocate its storage, and initialize its value."""
    if symbols.local_index(state, name) >= 0:
        diagnostics.fail_at(state, "variable is already declared; shadowing is forbidden")
    same_module: bool = symbols.module_prefix(name) == symbols.module_prefix(state.function_name)
    if builtins.reserved_name(name) || same_module && (symbols.record_index(state, name) >= 0 || symbols.function_index(state, name) >= 0):
        diagnostics.fail_at(state, "reserved variable name '" + name + "'")
    if typ == "void":
        diagnostics.fail_at(state, "void is only a return type")
    value = literals.coerce(state, value, typ)
    pointer: str = ir.slot(state, typ)
    ir.emit(state, "store " + ir.typed(state, value) + ", ptr " + pointer)
    core.append(state.names, name)
    core.append(state.types, typ)
    core.append(state.pointers, pointer)
    core.append(state.depths, state.depth[0])
