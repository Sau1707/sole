import core
import raw.llvm


def llvm_object(text: str, output: str, level: int32, check_only: bool) -> str:
    """Verify LLVM IR and optionally optimize it into a native object file."""

    # Parse and verify the generated module before target-specific work.
    context: ptr = raw.llvm.LLVMContextCreate()
    buffer: ptr = raw.llvm.LLVMCreateMemoryBufferWithMemoryRangeCopy(core.cstr(text), uint64(core.len(text)), core.cstr("sole"))
    module_handle: ptr = ptr(0)
    error_message: ptr = ptr(0)
    error: str = ""

    # LLVMParseIRInContext consumes the memory buffer on both outcomes.
    if raw.llvm.LLVMParseIRInContext(context, buffer, core.address(module_handle), core.address(error_message)) != 0:
        error = "" + core.from_cstr(error_message)
        raw.llvm.LLVMDisposeMessage(error_message)
        raw.llvm.LLVMContextDispose(context)
        return error
    if raw.llvm.LLVMVerifyModule(module_handle, 2, core.address(error_message)) != 0:
        error = "" + core.from_cstr(error_message)
    if error_message != ptr(0):
        raw.llvm.LLVMDisposeMessage(error_message)
        error_message = ptr(0)
    if error != "" || check_only:
        raw.llvm.LLVMDisposeModule(module_handle)
        raw.llvm.LLVMContextDispose(context)
        return error

    # Create the native target machine and apply its memory layout.
    raw.llvm.LLVMInitializeX86TargetInfo()
    raw.llvm.LLVMInitializeX86Target()
    raw.llvm.LLVMInitializeX86TargetMC()
    raw.llvm.LLVMInitializeX86AsmPrinter()
    triple: ptr = raw.llvm.LLVMGetDefaultTargetTriple()
    target_handle: ptr = ptr(0)
    if raw.llvm.LLVMGetTargetFromTriple(triple, core.address(target_handle), core.address(error_message)) != 0:
        error = "" + core.from_cstr(error_message)
        raw.llvm.LLVMDisposeMessage(error_message)
        raw.llvm.LLVMDisposeMessage(triple)
        raw.llvm.LLVMDisposeModule(module_handle)
        raw.llvm.LLVMContextDispose(context)
        return error
    relocation: int32 = 2
    machine: ptr = raw.llvm.LLVMCreateTargetMachine(target_handle, triple, core.cstr("generic"), core.cstr(""), level, relocation, 0)
    if machine == ptr(0):
        raw.llvm.LLVMDisposeMessage(triple)
        raw.llvm.LLVMDisposeModule(module_handle)
        raw.llvm.LLVMContextDispose(context)
        return "cannot create LLVM target machine"
    raw.llvm.LLVMSetTarget(module_handle, triple)
    raw.llvm.LLVMDisposeMessage(triple)
    layout_handle: ptr = raw.llvm.LLVMCreateTargetDataLayout(machine)
    layout: ptr = raw.llvm.LLVMCopyStringRepOfTargetData(layout_handle)
    raw.llvm.LLVMSetDataLayout(module_handle, layout)
    raw.llvm.LLVMDisposeMessage(layout)
    raw.llvm.LLVMDisposeTargetData(layout_handle)

    # Apply the requested LLVM optimization pipeline.
    if level > 0:
        passes: str = "default<O" + str(level) + ">"
        options: ptr = raw.llvm.LLVMCreatePassBuilderOptions()
        pass_error: ptr = raw.llvm.LLVMRunPasses(module_handle, core.cstr(passes), machine, options)
        raw.llvm.LLVMDisposePassBuilderOptions(options)
        if pass_error != ptr(0):
            error_message = raw.llvm.LLVMGetErrorMessage(pass_error)
            error = "" + core.from_cstr(error_message)
            raw.llvm.LLVMDisposeErrorMessage(error_message)
            error_message = ptr(0)

    # Write the object file and release LLVM resources.
    if error == "":
        if raw.llvm.LLVMTargetMachineEmitToFile(machine, module_handle, core.cstr(output), 1, core.address(error_message)) != 0:
            error = "" + core.from_cstr(error_message)
        if error_message != ptr(0):
            raw.llvm.LLVMDisposeMessage(error_message)
    raw.llvm.LLVMDisposeTargetMachine(machine)
    raw.llvm.LLVMDisposeModule(module_handle)
    raw.llvm.LLVMContextDispose(context)
    return error
