import core
import codegen.llvm.ir as ir
import semantic.model as model
import codegen.llvm.locals as locals
import codegen.llvm.context as context
import codegen.llvm.types as llvm_types
import diagnostics.report as diagnostics
import semantic.resolve.symbols as symbols
import codegen.llvm.statements as statements


def runtime_declarations(source: str) -> str[]:
    """Collect native runtime declarations as the foreign ABI registry."""
    declarations: str[] = []
    start: int64 = 0
    for end in range(core.len(source) + 1):
        if end == core.len(source) || source[end] == 10:
            line: str = core.slice(source, start, end)
            if core.len(line) >= 8 && core.slice(line, 0, 8) == "declare ":
                core.append(declarations, line)
            start = end + 1
    return declarations


def compile_function(state: context.State, fn: model.FunctionInfo, runtime: str[]) -> void:
    """Emit a foreign declaration or compile a function's parameters and body."""
    parameter_parts: str[] = []
    for i in range(core.len(fn.types)):
        if i > 0:
            core.append(parameter_parts, ", ")
        core.append(parameter_parts, llvm_types.llvm_type(state, fn.types[i]))
        if not fn.external:
            core.append(parameter_parts, " %arg" + str(i))
    prefix: str = "define "
    if fn.external:
        prefix = "declare "
    header: str = prefix + llvm_types.llvm_type(state, fn.result) + " @" + ir.function_symbol(fn) + "(" + core.join(parameter_parts) + ")"
    if fn.external:
        state.tokens.position[0] = fn.body
        for native in range(core.len(runtime)):
            declaration: str = runtime[native]
            symbol_start: int64 = 0
            while symbol_start < core.len(declaration) && declaration[symbol_start] != 64:
                symbol_start = symbol_start + 1
            symbol_end: int64 = symbol_start
            while symbol_end < core.len(declaration) && declaration[symbol_end] != 40:
                symbol_end = symbol_end + 1
            if core.slice(declaration, symbol_start, symbol_end) == "@" + ir.function_symbol(fn):
                if declaration != header:
                    diagnostics.fail_at(state, "conflicting external declaration: " + symbols.foreign_name(fn.name))
                return

        # Reuse compatible declarations of the same foreign symbol.
        for previous in range(core.len(state.functions)):
            other: model.FunctionInfo = state.functions[previous]
            if other.name == fn.name:
                break
            if other.external && symbols.foreign_name(other.name) == symbols.foreign_name(fn.name):
                if llvm_types.llvm_type(state, other.result) != llvm_types.llvm_type(state, fn.result) || core.len(other.types) != core.len(fn.types):
                    diagnostics.fail_at(state, "conflicting external declaration: " + symbols.foreign_name(fn.name))
                for p in range(core.len(fn.types)):
                    if llvm_types.llvm_type(state, other.types[p]) != llvm_types.llvm_type(state, fn.types[p]):
                        diagnostics.fail_at(state, "conflicting external declaration: " + symbols.foreign_name(fn.name))
                return
        core.append(state.definitions, header + " nobuiltin\n")
        return

    # Reset per-function state before declaring parameters and compiling blocks.
    state.tokens.position[0] = fn.body
    state.code = []
    state.slots = []
    state.names = []
    state.types = []
    state.pointers = []
    state.depths = []
    state.loops = []
    state.serial[0] = 0
    state.depth[0] = 0
    state.ended[0] = false
    state.result = fn.result
    state.loop_depth[0] = 0
    state.function_name = fn.name
    for j in range(core.len(fn.types)):
        locals.declare_local(state, fn.names[j], fn.types[j], context.Value(fn.types[j], "%arg" + str(j), ""))
    statements.compile_block(state)
    if not state.ended[0]:
        if fn.result != "void":
            diagnostics.fail_at(state, "function must return on every checked path: " + fn.name)
        ir.emit(state, "ret void")
    core.append(state.definitions, header + " nobuiltin {\nentry:\n" + core.join(state.slots) + "  br label %body\nbody:\n" + core.join(state.code) + "}\n")
