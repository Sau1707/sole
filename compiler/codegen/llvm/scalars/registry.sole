import codegen.llvm.scalars.definition as scalar_definition
import codegen.llvm.scalars.int8 as scalar_int8
import codegen.llvm.scalars.int16 as scalar_int16
import codegen.llvm.scalars.int32 as scalar_int32
import codegen.llvm.scalars.int64 as scalar_int64
import codegen.llvm.scalars.uint8 as scalar_uint8
import codegen.llvm.scalars.uint16 as scalar_uint16
import codegen.llvm.scalars.uint32 as scalar_uint32
import codegen.llvm.scalars.uint64 as scalar_uint64
import codegen.llvm.scalars.float32 as scalar_float32
import codegen.llvm.scalars.float64 as scalar_float64
import codegen.llvm.scalars.bool as scalar_bool
import codegen.llvm.scalars.str as scalar_str
import codegen.llvm.scalars.ptr as scalar_ptr
import codegen.llvm.scalars.void as scalar_void


def lookup(name: str) -> scalar_definition.Type:
    if name == "int8":
        return scalar_int8.int8().definition()
    if name == "int16":
        return scalar_int16.int16().definition()
    if name == "int32":
        return scalar_int32.int32().definition()
    if name == "int64":
        return scalar_int64.int64().definition()
    if name == "uint8":
        return scalar_uint8.uint8().definition()
    if name == "uint16":
        return scalar_uint16.uint16().definition()
    if name == "uint32":
        return scalar_uint32.uint32().definition()
    if name == "uint64":
        return scalar_uint64.uint64().definition()
    if name == "float32":
        return scalar_float32.float32().definition()
    if name == "float64":
        return scalar_float64.float64().definition()
    if name == "bool":
        return scalar_bool.bool().definition()
    if name == "str":
        return scalar_str.str().definition()
    if name == "ptr":
        return scalar_ptr.ptr().definition()
    if name == "void":
        return scalar_void.void().definition()
    return scalar_definition.Type(name, "", 0, "", false)
