import core
import codegen.llvm.ir as ir
import semantic.model as model
import diagnostics.report as report
import codegen.llvm.locals as locals
import syntax.parser.tokens as tokens
import codegen.llvm.context as context
import codegen.llvm.sumtypes as sumtypes
import semantic.resolve.symbols as symbols
import semantic.resolve.variants as variants


struct MatchInfo:
    subject: context.Value
    info: model.SumInfo
    tag: str
    covered: bool[]
    next: str
    end: str
    all_ended: bool


def begin(state: context.State, subject: context.Value) -> MatchInfo:
    """TODO: Document this function."""
    si: int64 = symbols.sum_index(state, subject.typ)
    if si < 0:
        report.fail_at(state, "match requires an enum or union")
    info: model.SumInfo = state.sums[si]
    tag: str = subject.value
    if info.kind == "union":
        tag = ir.extract(state, subject, 0)
    covered: bool[] = []
    for i in range(core.len(info.variants)):
        core.append(covered, false)
    tokens.expect(state, ":")
    tokens.expect(state, "<newline>")
    tokens.expect(state, "<indent>")
    return MatchInfo(subject, info, tag, covered, "", state.fresh(), true)


def begin_arm(state: context.State, plan: MatchInfo) -> MatchInfo:
    """TODO: Document this function."""
    tokens.expect(state, "case")
    owner_position: int64 = state.tokens.position
    owner: str = tokens.identifier(state)
    if owner != plan.info.name:
        state.tokens.position = owner_position
        report.fail_at(state, "case belongs to a different type; expected " + plan.info.name)
    tokens.expect(state, ".")
    member_position: int64 = state.tokens.position
    variant: int64 = variants.variant_index(state, plan.info, tokens.identifier(state))
    if plan.covered[variant]:
        state.tokens.position = member_position
        report.fail_at(state, "duplicate match case")
    plan.covered[variant] = true
    binders: str[] = []
    if plan.info.kind == "union":
        tokens.expect(state, "(")
        while tokens.peek(state) != ")":
            core.append(binders, tokens.identifier(state))
            if not tokens.accept(state, ","):
                break
        tokens.expect(state, ")")
    payload: model.VariantInfo = plan.info.variants[variant]
    if core.len(binders) != core.len(payload.types):
        report.fail_at(state, "wrong number of pattern bindings")
    yes: str = state.fresh()
    plan.next = state.fresh()
    condition: str = ir.instruction(state, "icmp eq i32 " + plan.tag + ", " + str(variant))
    ir.emit(state, "br i1 " + condition + ", label %" + yes + ", label %" + plan.next)
    ir.block_label(state, yes)
    state.depth = state.depth + 1
    offset: int64 = sumtypes.payload_offset(plan.info, variant)
    for i in range(core.len(binders)):
        value: context.Value = context.Value(payload.types[i], ir.extract(state, plan.subject, offset + i), "")
        locals.declare_local(state, binders[i], payload.types[i], value)
    return plan


def end_arm(state: context.State, plan: MatchInfo) -> MatchInfo:
    """TODO: Document this function."""
    if not state.ended:
        plan.all_ended = false
        ir.emit(state, "br label %" + plan.end)
    symbols.end_scope(state)
    ir.block_label(state, plan.next)
    return plan


def finish(state: context.State, plan: MatchInfo) -> void:
    """TODO: Document this function."""
    tokens.expect(state, "<dedent>")
    for i in range(core.len(plan.covered)):
        if not plan.covered[i]:
            report.fail_at(state, "non-exhaustive match; missing " + plan.info.name + "." + plan.info.variants[i].name)
    ir.emit(state, "call void @llvm.trap()")
    ir.emit(state, "unreachable")
    ir.block_label(state, plan.end)
    if plan.all_ended:
        ir.emit(state, "unreachable")
        state.ended = true
