import core
import strings
import os.path
import driver.linker as linker
import syntax.lexer.tokens as tokens
import syntax.lexer.characters as characters
import codegen.llvm.functions as functions


def main() -> int32:
    if linker.native_linker() != core.arg(1):
        return 1
    for byte in range(256):
        digit: bool = byte >= 48 && byte <= 57
        letter: bool = byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte == 95
        if characters.digit(uint8(byte)) != digit || characters.letter(uint8(byte)) != letter:
            return 2
    source: tokens.Tokens = tokens.Tokens([], [], [], [0], [])
    copy: tokens.Tokens = source
    paths: str[] = ["", "file", "/", "//", "a/", "a//b", "/猫/é.sole", "a\0b", "///", "a///", "//a//b", "a\0b/c"]
    basenames: str[] = ["", "file", "", "", "", "b", "é.sole", "a\0b", "", "", "b", "c"]
    directories: str[] = ["", "", "/", "//", "a", "a", "/猫", "", "///", "a", "//a", "a\0b"]
    absolute: bool[] = [false, false, true, true, false, false, true, false, true, false, true, false]
    for i in range(core.len(paths)):
        if os.path.basename(paths[i]) != basenames[i]:
            return 6
        if os.path.dirname(paths[i]) != directories[i] || os.path.isabs(paths[i]) != absolute[i]:
            return 7
    if os.path.join("", "") != "" || os.path.join("", "file") != "file" || os.path.join("a", "") != "a/":
        return 8
    if os.path.join("a/", "b") != "a/b" || os.path.join("a//", "b") != "a//b" || os.path.join("a", "b") != "a/b":
        return 9
    if os.path.join("a", "/b") != "/b" || os.path.join("a", "//b") != "//b" || os.path.join("猫", "é") != "猫/é":
        return 10
    if os.path.join("a\0b", "c") != "a\0b/c":
        return 11
    if core.len(functions.runtime_declarations("")) != 0 || core.len(functions.runtime_declarations("\n; comment\n")) != 0:
        return 12
    declarations: str[] = functions.runtime_declarations("declare void @first()")
    if core.len(declarations) != 1 || declarations[0] != "declare void @first()":
        return 13
    declarations = functions.runtime_declarations("; comment\ndeclare void @first()\n\ndeclare i64 @last()\n")
    if core.len(declarations) != 2 || declarations[0] != "declare void @first()" || declarations[1] != "declare i64 @last()":
        return 14
    tokens.add(source, "name", 1, 7)
    if core.len(source.text) != 1 || source.text[0] != "name" || source.line[0] != 7:
        return 15
    source.position[0] = 1
    if copy.position[0] != 1:
        return 16
    if strings.find("", "") != 0 || strings.find("abc", "") != 0 || strings.find("", "a") != -1:
        return 18
    if strings.find("abc", "c") != 2 || strings.find("abc", "abc") != 0 || strings.find("abc", "abcd") != -1:
        return 19
    return 0
