import core
import records as models


struct Pair:
    first: int32
    second: int32


struct Trace:
    digits: int32


def mark(trace: Trace[], digit: int32) -> int32:
    trace[0].digits = trace[0].digits * 10 + digit
    return digit


struct Box:
    pair: Pair
    data: int16[2]


def sum(box: Box) -> int32:
    return box.pair.first + box.pair.second


struct Numbers:
    small: int8
    byte: uint8
    real: float32
    fixed: int16[2]
    dynamic: uint8[]


struct Empty:
    pass


def identity(value: int32) -> int32:
    return value


def main() -> int32:
    trace: Trace[] = [Trace(0)]
    pair: Pair = Pair(mark(trace, 1), mark(trace, 2))
    if trace[0].digits != 12 || pair.first != 1 || pair.second != 2:
        return 1
    mixed: Pair = Pair(mark(trace, 3), mark(trace, 4))
    if trace[0].digits != 1234 || mixed.first != 3 || mixed.second != 4:
        return 2
    box: Box = Box(Pair(5, 6), [7, 8])
    if sum(box) != 11 || box.data[0] != 7 || box.data[1] != 8:
        return 3
    numbers: Numbers = Numbers(-128, 255, 1.5, [-32768, 32767], [0, 255])
    if numbers.small != -128 || numbers.byte != 255 || numbers.real != 1.5:
        return 4
    if numbers.fixed[0] != -32768 || numbers.fixed[1] != 32767 || numbers.dynamic[1] != 255:
        return 5
    imported: models.Pair = models.Pair(9, 10)
    reference: models.Box = models.Box(255, [11, 12])
    if imported.first != 9 || imported.second != 10 || reference.small != 255 || reference.items[1] != 12:
        return 6
    positional: Pair = Pair(13, 14)
    empty: Empty = Empty()
    if identity(positional.first) != 13 || positional.second != 14:
        return 7
    nested_trace: Trace[] = [Trace(0)]
    nested_box: Box = Box(Pair(mark(nested_trace, 1), mark(nested_trace, 2)), [int16(mark(nested_trace, 3)), int16(mark(nested_trace, 4))])
    if nested_trace[0].digits != 1234 || sum(nested_box) != 3 || nested_box.data[0] != 3 || nested_box.data[1] != 4:
        return 8
    labels: models.Labels = models.Labels(1, 2)
    if labels.identity != 1 || labels.models != 2:
        return 9
    core.print("constructors passed")
    return 0
