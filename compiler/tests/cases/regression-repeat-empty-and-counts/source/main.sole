import core


def main() -> void:
    core.print("".repeat(9223372036854775807) == "")
    core.print("".repeat(0) == "")
    core.print("".repeat(-1) == "")
    core.print("abc".repeat(0) == "")
    core.print("abc".repeat(-7) == "")
    core.print("abc".repeat(1) == "abc")
    core.print("ab".repeat(3) == "ababab")
    core.print("é🙂".repeat(2) == "é🙂é🙂")
