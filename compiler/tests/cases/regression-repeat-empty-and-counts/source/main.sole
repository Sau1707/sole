import core
import strings


def main() -> void:
    core.print(strings.repeat("", 9223372036854775807) == "")
    core.print(strings.repeat("", 0) == "")
    core.print(strings.repeat("", -1) == "")
    core.print(strings.repeat("abc", 0) == "")
    core.print(strings.repeat("abc", -7) == "")
    core.print(strings.repeat("abc", 1) == "abc")
    core.print(strings.repeat("ab", 3) == "ababab")
    core.print(strings.repeat("é🙂", 2) == "é🙂é🙂")
