import core
import string_array


struct Names:
    values: str[]

def contains(names: Names, value: str) -> bool:
    return string_array.contains(names.values, value)


def values(calls: int64[]) -> str[]:
    calls[0] = calls[0] + 1
    return ["", "猫", "a\0b", "猫"]


def main() -> int32:
    empty: str[] = []
    if string_array.contains(empty, "") || string_array.index_of(empty, "") != -1:
        return 1
    calls: int64[] = [0]
    if not string_array.contains(values(calls), "猫") || calls[0] != 1:
        return 2
    names: str[] = values(calls)
    if string_array.index_of(names, "猫") != 1 || string_array.index_of(names, "a\0b") != 2 || string_array.index_of(names, "missing") != -1:
        return 3
    if not string_array.contains(names, "") || string_array.contains(names, "a") || string_array.contains(names, "\0"):
        return 4
    holder: Names = Names(names)
    if not contains(holder, "猫") || string_array.index_of(holder.values, "a\0b") != 2:
        return 5
    if core.len(names) != 4 || names[2] != "a\0b":
        return 6
    core.print("array methods ok")
    return 0
