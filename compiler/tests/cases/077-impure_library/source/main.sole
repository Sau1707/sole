import core
import files
import env
def main() -> void:
    core.write_file("@DATA_ROOT@/0/first.txt", "data")
    core.print(core.read_file("@DATA_ROOT@/0/first.txt"))
    core.print(files.is_file("@DATA_ROOT@/0/first.txt"))
    core.print(files.same_file("@DATA_ROOT@/0/first.txt", "@DATA_ROOT@/0/./first.txt"))
    core.print(env.get("SOLE_MODULE_TEST", "missing"))
    core.print(env.get("SOLE_MODULE_TEST", "missing") != "missing")
