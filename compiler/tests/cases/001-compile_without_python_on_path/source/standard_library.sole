import core
import bisect
import statistics
import os.path

def main() -> void:
    values: int64[] = [1, 3, 3, 7]
    core.print(bisect.bisect_left(values, 3))
    core.print(bisect.bisect_right(values, 3))
    bisect.insort(values, 5)
    core.print(values[3])

    samples: float64[] = [7.0, 1.0, 3.0, 5.0]
    core.print(statistics.mean(samples))
    core.print(statistics.median(samples))
    core.print(statistics.pvariance(samples))

    core.print(os.path.join("data", "results.txt"))
    core.print(os.path.basename("data/results.txt"))
    core.print(os.path.normpath("data/./old/../results.txt"))
