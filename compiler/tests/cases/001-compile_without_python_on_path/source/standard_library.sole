import core
import strings
import string_array
import os.path

def main() -> void:
    core.print(string_array.index_of(["a", "b", "c"], "b"))
    core.print(strings.replace("a/b", "/", "."))
    core.print(os.path.split("data/results.txt")[1])
    core.print(os.path.replace_suffix("results.sole", ".sole", ".o"))
