import core
class Buffer:
    bytes: uint64[4]
class Empty:
    pass
def main() -> int32:
    i: int32 = 0
    while i < 12000:
        b: Buffer = Buffer([1, 2, 3, 4])
        if b.bytes[3] != 4:
            return 1
        i = i + 1
    a: Empty = Empty()
    b: Empty = Empty()
    core.print(a != b)
    return 0
