import core


def main() -> int32:
    for i in range(256):
        byte: uint8 = uint8(i)
        if byte.is_digit() != (i >= 48 && i <= 57):
            return 1
        if byte.is_alpha() != (i >= 65 && i <= 90 || i >= 97 && i <= 122):
            return 2
        if byte.is_space() != (i == 32 || i >= 9 && i <= 13):
            return 3
        lower: uint8 = byte
        upper: uint8 = byte
        if i >= 65 && i <= 90:
            lower = uint8(i + 32)
        if i >= 97 && i <= 122:
            upper = uint8(i - 32)
        if byte.to_lower() != lower || byte.to_upper() != upper:
            return 4
    if not b'A'.to_lower().is_alpha() || not "9"[0].is_digit():
        return 5
    core.print("byte methods ok")
    return 0
