import core
struct Buffer:
    bytes: uint64[4]
def get(buffer: Buffer, index: int64) -> uint64:
    return buffer.bytes[index]
struct Empty:
    pass
def main() -> int32:
    i: int32 = 0
    while i < 12000:
        b: Buffer[] = [Buffer([1, 2, 3, 4])]
        if get(b[0], 3) != 4:
            return 1
        i = i + 1
    a: Empty = Empty()
    b: Empty = Empty()
    first: int32[] = [0]
    second: int32[] = [0]
    first[0] = 1
    core.print(first[0] != second[0])
    return 0
