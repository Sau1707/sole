import core


struct Counter:
    value: int32

def change(counter: Counter[]) -> void:
    (counter[0]).value = 7
    ((counter[0].value)) = counter[0].value + 4
    alias: Counter[] = counter
    alias = [Counter(99)]


def main() -> int32:
    counter: Counter[] = [Counter(1)]
    other: Counter[] = counter
    (counter) = [Counter(7)]
    core.print(counter[0].value)
    change(other)
    core.print(other[0].value)
    return 0
