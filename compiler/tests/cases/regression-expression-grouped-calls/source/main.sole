import core


class Counter:
    value: int32

    def add(self, amount: int32) -> void:
        self.value = self.value + amount


def number(value: int32) -> int32:
    core.print(value)
    return value


def main() -> int32:
    number(1)
    (number(2))
    ((number(3)))
    (core.print(4))
    Counter(0)
    int32(9)
    counter: Counter = Counter(0)
    (counter.add(2))
    ((counter).add(5))
    core.print(counter.value)
    return 0
