import core


struct Counter:
    value: int32

def add(counter: Counter[], amount: int32) -> void:
    counter[0].value = counter[0].value + amount


def number(value: int32) -> int32:
    core.print(value)
    return value


def main() -> int32:
    number(1)
    (number(2))
    ((number(3)))
    (core.print(4))
    Counter(0)
    int32(9)
    counter: Counter[] = [Counter(0)]
    (add(counter, 2))
    (add((counter), 5))
    core.print(counter[0].value)
    return 0
