import core
import bisect
def main() -> void:
    values: int64[] = [-4, 0, 3, 3, 3, 9]
    core.print(bisect.bisect_left(values, -10))
    core.print(bisect.bisect_right(values, -10))
    core.print(bisect.bisect(values, -10))
    core.print(bisect.bisect_left(values, -4))
    core.print(bisect.bisect_right(values, -4))
    core.print(bisect.bisect(values, -4))
    core.print(bisect.bisect_left(values, 1))
    core.print(bisect.bisect_right(values, 1))
    core.print(bisect.bisect(values, 1))
    core.print(bisect.bisect_left(values, 3))
    core.print(bisect.bisect_right(values, 3))
    core.print(bisect.bisect(values, 3))
    core.print(bisect.bisect_left(values, 9))
    core.print(bisect.bisect_right(values, 9))
    core.print(bisect.bisect(values, 9))
    core.print(bisect.bisect_left(values, 20))
    core.print(bisect.bisect_right(values, 20))
    core.print(bisect.bisect(values, 20))
    bisect.insort_left(values, 3)
    bisect.insort_right(values, -10)
    bisect.insort(values, 20)
    core.print(values[0])
    core.print(values[1])
    core.print(values[2])
    core.print(values[3])
    core.print(values[4])
    core.print(values[5])
    core.print(values[6])
    core.print(values[7])
    core.print(values[8])
    empty: int64[] = []
    core.print(bisect.bisect_left(empty, 1))
    core.print(bisect.bisect_right(empty, 1))
    bisect.insort(empty, 1)
    core.print(empty[0])
