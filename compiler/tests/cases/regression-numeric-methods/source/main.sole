import core
import wrappers.system as system


def main() -> int32:
    a8: int8 = int8(-12).abs().min(10).max(4).clamp(0, 7)
    a16: int16 = int16(-12).abs().min(10).max(4).clamp(0, 7)
    a32: int32 = int32(-12).abs().min(10).max(4).clamp(0, 7)
    a64: int64 = int64(-12).abs().min(10).max(4).clamp(0, 7)
    if a8 != 7 || a16 != 7 || a32 != 7 || a64 != 7:
        return 1
    if int8(-12).gcd(8) != 4 || int16(-12).gcd(-8) != 4 || int32(12).gcd(-8) != 4 || int64(12).gcd(8) != 4:
        return 2
    if int8(0).gcd(0) != 0 || int16(0).gcd(8) != 8 || int32(-8).gcd(0) != 8 || int64(17).gcd(13) != 1:
        return 3
    if int8(-128).abs() != -128 || int16(-32768).abs() != -32768 || int32(-2147483648).abs() != -2147483648 || int64(-9223372036854775808).abs() != -9223372036854775808:
        return 4
    if int8(-128).min(127) != -128 || int16(-32768).max(32767) != 32767 || int32(0).clamp(9, 3) != 3 || int64(5).clamp(0, 9) != 5:
        return 5
    u8: uint8 = uint8(255).abs().min(200).max(250).clamp(0, 252)
    u16: uint16 = uint16(65535).abs().min(50000).max(60000).clamp(0, 61000)
    u32: uint32 = uint32(4294967295).abs().min(3000000000).max(4000000000).clamp(0, 4100000000)
    u64: uint64 = uint64(18446744073709551615).abs().min(10000000000000000000).max(18000000000000000000).clamp(0, 18100000000000000000)
    if u8 != 250 || u16 != 60000 || u32 != 4000000000 || u64 != 18000000000000000000:
        return 6
    if uint8(255).gcd(15) != 15 || uint16(65535).gcd(255) != 255 || uint32(4294967295).gcd(65535) != 65535 || uint64(18446744073709551615).gcd(4294967295) != 4294967295:
        return 7
    if uint8(0).gcd(0) != 0 || uint16(0).gcd(8) != 8 || uint32(8).gcd(0) != 8 || uint64(17).gcd(13) != 1:
        return 8
    if uint8(0).max(255) != 255 || uint16(65535).min(0) != 0 || uint32(0).clamp(9, 3) != 3 || uint64(5).clamp(0, 9) != 5:
        return 9
    f32: float32 = float32(-12.5).abs().min(10.5).max(4.5).clamp(0.5, 7.5)
    f64: float64 = float64(-12.5).abs().min(10.5).max(4.5).clamp(0.5, 7.5)
    if f32 != 7.5 || f64 != 7.5 || float32(0.0).clamp(9.0, 3.0) != 3.0 || float64(5.0).clamp(0.0, 9.0) != 5.0:
        return 10
    nan32: float32 = float32(0.0) / float32(0.0)
    nan64: float64 = 0.0 / 0.0
    if nan32.abs() == nan32.abs() || nan64.abs() == nan64.abs():
        return 11
    if nan32.min(2.0) != 2.0 || nan32.max(2.0) != 2.0 || nan64.min(2.0) != 2.0 || nan64.max(2.0) != 2.0:
        return 12
    if float32(2.0).min(nan32) == float32(2.0).min(nan32) || float64(2.0).max(nan64) == float64(2.0).max(nan64):
        return 13
    minus_zero: float64 = -0.0
    if system.sole_rt_f64_bits(minus_zero.abs()) != 9223372036854775808 || system.sole_rt_f64_bits(float64(0.0).min(minus_zero)) != 9223372036854775808:
        return 14
    infinity: float64 = 1.0 / 0.0
    if (-infinity).abs() != infinity || infinity.clamp(-5.0, 5.0) != 5.0:
        return 15
    if (48).gcd(18) != 6 || (-7).abs() != 7 || (2.5).clamp(0.0, 2.0) != 2.0:
        return 16
    core.print("numeric methods ok")
    return 0
