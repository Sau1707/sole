import core
def main() -> int32:
    parts: str[] = ["a", "b"]
    core.append(parts, "c")
    core.print(core.join(parts))
    core.print("a\0b" == "a\0b")
    core.print("a\0b" != "a")
    core.print(core.slice("hello", 1, 4))
    core.print("hello"[0])
    core.print(str(int64(-9223372036854775808)))
    core.print(str(uint64(18446744073709551615)))
    core.print(-(-1))
    core.print(0xE + 1)
    return 0
