import core
struct Point:
    x: int32
struct Box:
    point: Point
    data: int32[2]
def set(box: Box[], value: int32) -> void:
    box[0].point.x = value
def get(box: Box[]) -> Box[]:
    core.print("get")
    return box
def changed(p: Point) -> Point:
    p.x = 99
    return p
def main() -> int32:
    p: Point = Point(1)
    q: Point = changed(p)
    core.print(p.x)
    core.print(q.x)
    box: Box[] = [Box(p, [10, 20])]
    alias: Box[] = box
    set(alias, 7)
    core.print(box[0].point.x)
    get(box)[0].point.x = 8
    core.print(box[0].point.x)
    get(box)[0].data[1] = 30
    core.print(box[0].data[1])
    points: Point[2] = [Point(2), Point(3)]
    points[1].x = 4
    core.print(points[1].x)
    nums: int32[2] = [1, 2]
    copy: int32[2] = nums
    copy[0] = 5
    core.print(nums[0])
    return 0
