struct Point:
    x: int32
struct Counter:
    value: int32
def add(counter: Counter[], amount: int32) -> void:
    counter[0].value = counter[0].value + amount
def main() -> int32:
    point: Point = Point(36)
    copy: Point = point
    copy.x = 99
    counter: Counter[] = [Counter(0)]
    values: int32[3] = [1, 2, 3]
    i: int32 = 0
    while i < 3:
        add(counter, values[i])
        i = i + 1
    return point.x + counter[0].value
