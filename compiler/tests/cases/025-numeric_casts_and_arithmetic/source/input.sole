import core
def main() -> int32:
    core.print(-7 / 3)
    core.print(-7 % 3)
    core.print(uint8(int16(257)))
    core.print(int32(uint32(4294967295)))
    core.print(uint64(int64(-1)))
    core.print(int32(3.9))
    core.print(float32(int8(-5)))
    core.print(float64(uint64(18446744073709551615)) > 0.0)
    core.print(int8(-128))
    core.print(int64(-9223372036854775808))
    core.print(bool(0))
    core.print(bool(-1))
    core.print(int32(true))
    core.print(uint8(255) >> 1)
    core.print(int8(-8) >> 1)
    core.print((int32(1) << 3) | 2)
    core.print(~uint8(0))
    return 0
