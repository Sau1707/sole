import core
import statistics
def main() -> void:
    data0: float64[] = [4.0]
    result0_mean: float64 = statistics.mean(data0)
    core.print(result0_mean >= 3.9999999999 && result0_mean <= 4.0000000001)
    result0_fmean: float64 = statistics.fmean(data0)
    core.print(result0_fmean >= 3.9999999999 && result0_fmean <= 4.0000000001)
    result0_median: float64 = statistics.median(data0)
    core.print(result0_median >= 3.9999999999 && result0_median <= 4.0000000001)
    result0_median_low: float64 = statistics.median_low(data0)
    core.print(result0_median_low >= 3.9999999999 && result0_median_low <= 4.0000000001)
    result0_median_high: float64 = statistics.median_high(data0)
    core.print(result0_median_high >= 3.9999999999 && result0_median_high <= 4.0000000001)
    result0_pvariance: float64 = statistics.pvariance(data0)
    core.print(result0_pvariance >= -1e-10 && result0_pvariance <= 1e-10)
    core.print(data0[0] == 4.0)
    data1: float64[] = [7.0, 1.0, 3.0]
    result1_mean: float64 = statistics.mean(data1)
    core.print(result1_mean >= 3.6666666665666665 && result1_mean <= 3.6666666667666665)
    result1_fmean: float64 = statistics.fmean(data1)
    core.print(result1_fmean >= 3.6666666665666665 && result1_fmean <= 3.6666666667666665)
    result1_median: float64 = statistics.median(data1)
    core.print(result1_median >= 2.9999999999 && result1_median <= 3.0000000001)
    result1_median_low: float64 = statistics.median_low(data1)
    core.print(result1_median_low >= 2.9999999999 && result1_median_low <= 3.0000000001)
    result1_median_high: float64 = statistics.median_high(data1)
    core.print(result1_median_high >= 2.9999999999 && result1_median_high <= 3.0000000001)
    result1_pvariance: float64 = statistics.pvariance(data1)
    core.print(result1_pvariance >= 6.222222222122222 && result1_pvariance <= 6.222222222322222)
    result1_variance: float64 = statistics.variance(data1)
    core.print(result1_variance >= 9.333333333233334 && result1_variance <= 9.333333333433334)
    core.print(data1[0] == 7.0)
    core.print(data1[1] == 1.0)
    core.print(data1[2] == 3.0)
    data2: float64[] = [9.0, -1.0, 5.0, 3.0]
    result2_mean: float64 = statistics.mean(data2)
    core.print(result2_mean >= 3.9999999999 && result2_mean <= 4.0000000001)
    result2_fmean: float64 = statistics.fmean(data2)
    core.print(result2_fmean >= 3.9999999999 && result2_fmean <= 4.0000000001)
    result2_median: float64 = statistics.median(data2)
    core.print(result2_median >= 3.9999999999 && result2_median <= 4.0000000001)
    result2_median_low: float64 = statistics.median_low(data2)
    core.print(result2_median_low >= 2.9999999999 && result2_median_low <= 3.0000000001)
    result2_median_high: float64 = statistics.median_high(data2)
    core.print(result2_median_high >= 4.9999999999 && result2_median_high <= 5.0000000001)
    result2_pvariance: float64 = statistics.pvariance(data2)
    core.print(result2_pvariance >= 12.9999999999 && result2_pvariance <= 13.0000000001)
    result2_variance: float64 = statistics.variance(data2)
    core.print(result2_variance >= 17.333333333233334 && result2_variance <= 17.33333333343333)
    core.print(data2[0] == 9.0)
    core.print(data2[1] == -1.0)
    core.print(data2[2] == 5.0)
    core.print(data2[3] == 3.0)
    data3: float64[] = [2.0, 2.0, 2.0]
    result3_mean: float64 = statistics.mean(data3)
    core.print(result3_mean >= 1.9999999999 && result3_mean <= 2.0000000001)
    result3_fmean: float64 = statistics.fmean(data3)
    core.print(result3_fmean >= 1.9999999999 && result3_fmean <= 2.0000000001)
    result3_median: float64 = statistics.median(data3)
    core.print(result3_median >= 1.9999999999 && result3_median <= 2.0000000001)
    result3_median_low: float64 = statistics.median_low(data3)
    core.print(result3_median_low >= 1.9999999999 && result3_median_low <= 2.0000000001)
    result3_median_high: float64 = statistics.median_high(data3)
    core.print(result3_median_high >= 1.9999999999 && result3_median_high <= 2.0000000001)
    result3_pvariance: float64 = statistics.pvariance(data3)
    core.print(result3_pvariance >= -1e-10 && result3_pvariance <= 1e-10)
    result3_variance: float64 = statistics.variance(data3)
    core.print(result3_variance >= -1e-10 && result3_variance <= 1e-10)
    core.print(data3[0] == 2.0)
    core.print(data3[1] == 2.0)
    core.print(data3[2] == 2.0)
