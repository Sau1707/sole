import core


class Label:
    text: str

    def contains(self, needle: str) -> bool:
        return self.text.contains(needle)


def text(calls: int64[]) -> str:
    calls[0] = calls[0] + 1
    return "é\0猫"


def main() -> int32:
    value: str = "é\0猫"
    if not "".starts_with("") || not "".ends_with(""):
        return 1
    if "".starts_with("a") || "".ends_with("a"):
        return 2
    if not value.starts_with("é\0") || not value.ends_with("\0猫"):
        return 3
    if value.starts_with("é\0猫a") || value.ends_with("aé\0猫"):
        return 4
    if value.starts_with("猫") || value.ends_with("é"):
        return 5
    if value.find("猫") != 3 || value.find("\0") != 2 || value.find("a") != -1:
        return 6
    if not value.contains("") || not value.contains("\0猫") || value.contains("a"):
        return 7
    parts: str[] = value.partition("\0")
    if core.len(parts) != 3 || parts[0] != "é" || parts[1] != "\0" || parts[2] != "猫":
        return 8
    if value.replace("\0", "/").repeat(2) != "é/猫é/猫":
        return 9
    if not ("é" + "猫").ends_with("猫") || not Label(value).contains("猫"):
        return 10
    calls: int64[] = [0]
    if text(calls).replace("\0", "/").find("猫") != 3 || calls[0] != 1:
        return 11
    core.print("string methods ok")
    return 0
