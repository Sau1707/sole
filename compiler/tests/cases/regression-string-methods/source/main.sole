import core
import strings


struct Label:
    text: str

def contains(label: Label, needle: str) -> bool:
    return strings.find(label.text, needle) >= 0


def text(calls: int64[]) -> str:
    calls[0] = calls[0] + 1
    return "é\0猫"


def main() -> int32:
    value: str = "é\0猫"
    if not strings.starts_with("", "") || not strings.ends_with("", ""):
        return 1
    if strings.starts_with("", "a") || strings.ends_with("", "a"):
        return 2
    if not strings.starts_with(value, "é\0") || not strings.ends_with(value, "\0猫"):
        return 3
    if strings.starts_with(value, "é\0猫a") || strings.ends_with(value, "aé\0猫"):
        return 4
    if strings.starts_with(value, "猫") || strings.ends_with(value, "é"):
        return 5
    if strings.find(value, "猫") != 3 || strings.find(value, "\0") != 2 || strings.find(value, "a") != -1:
        return 6
    if strings.find(value, "") < 0 || strings.find(value, "\0猫") < 0 || strings.find(value, "a") >= 0:
        return 7
    parts: str[] = strings.partition(value, "\0")
    if core.len(parts) != 3 || parts[0] != "é" || parts[1] != "\0" || parts[2] != "猫":
        return 8
    if strings.replace(value, "\0", "/") != "é/猫":
        return 9
    if not strings.ends_with("é" + "猫", "猫") || not contains(Label(value), "猫"):
        return 10
    calls: int64[] = [0]
    if strings.find(strings.replace(text(calls), "\0", "/"), "猫") != 3 || calls[0] != 1:
        return 11
    core.print("string methods ok")
    return 0
