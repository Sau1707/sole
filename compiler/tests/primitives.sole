import core
import primitives.definition as definition
import primitives.registry as registry
import primitives.intrinsics as intrinsics


def require(condition: bool, description: str) -> void:
    """Reject invalid primitive metadata without importing the backend."""
    if not condition:
        core.print("FAIL: " + description)
        core.exit(1)


def main() -> int32:
    """Verify primitive recognition independently of LLVM lowering."""
    names: str[] = ["int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "bool", "ptr", "str", "void"]
    for i in range(core.len(names)):
        require(definition.known(registry.lookup(names[i])), names[i] + " is a primitive")
    require(not definition.known(registry.lookup("")), "empty name is not a primitive")
    require(not definition.known(registry.lookup("Point")), "user types are not primitives")
    require(not definition.known(registry.lookup("int64[]")), "arrays are not primitives")
    require(definition.numeric(registry.lookup("int64")), "integers are numeric")
    require(definition.numeric(registry.lookup("float32")), "floats are numeric")
    require(not definition.numeric(registry.lookup("bool")), "booleans are not numeric")
    require(not definition.numeric(registry.lookup("ptr")), "pointers are not numeric")
    require(not definition.numeric(registry.lookup("str")), "strings are not numeric")
    require(not definition.numeric(registry.lookup("void")), "void is not numeric")
    names = ["print", "len", "append", "slice", "join", "cstr", "from_cstr", "address", "arg_count", "arg", "read_file", "write_file"]
    for i in range(core.len(names)):
        require(intrinsics.builtin_name(names[i]), names[i] + " is an intrinsic")
    require(not intrinsics.builtin_name("malloc"), "libc calls are not intrinsics")
    require(not intrinsics.builtin_name("exit"), "exit is an ordinary library function")
    require(not intrinsics.builtin_name("LLVMContextCreate"), "LLVM APIs are not intrinsics")
    require(not intrinsics.builtin_name("sole_rt_f64_bits"), "runtime helpers are not intrinsics")
    require(not intrinsics.builtin_name(""), "empty name is not an intrinsic")
    core.print("Passed backend-independent primitive checks.")
    return 0
