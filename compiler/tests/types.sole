import core
import types.definition
import types.int16
import types.registry


def require(condition: bool, description: str) -> void:
    if not condition:
        core.print("FAIL: " + description)
        core.exit(1)


def check_integer(name: str, llvm: str, bits: int64, unsigned: bool) -> void:
    definition: types.definition.Type = types.registry.lookup(name)
    require(definition.name == name && definition.llvm == llvm, name + " representation")
    require(definition.integer() && not definition.floating(), name + " category")
    require(definition.bits == bits && definition.unsigned == unsigned, name + " width and signedness")
    require(definition.arithmetic("+") == "add", name + " addition")
    require(definition.arithmetic("-") == "sub", name + " subtraction")
    require(definition.arithmetic("*") == "mul", name + " multiplication")
    require(definition.arithmetic("&") == "and", name + " bitwise and")
    require(definition.arithmetic("|") == "or", name + " bitwise or")
    require(definition.arithmetic("^") == "xor", name + " bitwise xor")
    require(definition.arithmetic("<<") == "shl", name + " left shift")
    require(definition.comparison("==") == "icmp eq", name + " equality")
    require(definition.comparison("!=") == "icmp ne", name + " inequality")
    if unsigned:
        require(definition.arithmetic("/") == "udiv", name + " division")
        require(definition.arithmetic("%") == "urem", name + " remainder")
        require(definition.arithmetic(">>") == "lshr", name + " right shift")
        require(definition.comparison("<") == "icmp ult", name + " ordering")
        require(definition.lower_bound() == "0", name + " lower bound")
    else:
        require(definition.arithmetic("/") == "sdiv", name + " division")
        require(definition.arithmetic("%") == "srem", name + " remainder")
        require(definition.arithmetic(">>") == "ashr", name + " right shift")
        require(definition.comparison("<") == "icmp slt", name + " ordering")
        require(definition.maximum(true) == definition.maximum(false) + 1, name + " signed limits")


def main() -> int32:
    check_integer("int8", "i8", 8, false)
    check_integer("int16", "i16", 16, false)
    check_integer("int32", "i32", 32, false)
    check_integer("int64", "i64", 64, false)
    check_integer("uint8", "i8", 8, true)
    check_integer("uint16", "i16", 16, true)
    check_integer("uint32", "i32", 32, true)
    check_integer("uint64", "i64", 64, true)
    signed: types.definition.Type = types.int16.int16().definition()
    unsigned: types.definition.Type = types.registry.lookup("uint16")
    wide: types.definition.Type = types.registry.lookup("int64")
    narrow: types.definition.Type = types.registry.lookup("int8")
    real: types.definition.Type = types.registry.lookup("float32")
    double: types.definition.Type = types.registry.lookup("float64")
    boolean: types.definition.Type = types.registry.lookup("bool")
    pointer: types.definition.Type = types.registry.lookup("ptr")
    text: types.definition.Type = types.registry.lookup("str")
    nothing: types.definition.Type = types.registry.lookup("void")
    require(signed.conversion(unsigned) == "identity", "equal-width conversion")
    require(signed.conversion(wide) == "sext", "signed extension")
    require(unsigned.conversion(wide) == "zext", "unsigned extension")
    require(signed.conversion(narrow) == "trunc", "integer truncation")
    require(signed.conversion(real) == "sitofp", "signed to float")
    require(unsigned.conversion(real) == "uitofp", "unsigned to float")
    require(real.conversion(signed) == "fptosi", "float to signed")
    require(real.conversion(unsigned) == "fptoui", "float to unsigned")
    require(real.conversion(double) == "fpext", "float extension")
    require(double.conversion(real) == "fptrunc", "float truncation")
    require(boolean.conversion(wide) == "zext", "boolean extension")
    require(signed.conversion(boolean) == "icmp ne", "integer to boolean")
    require(real.conversion(boolean) == "fcmp une", "float to boolean")
    require(pointer.conversion(wide) == "ptrtoint", "pointer to integer")
    require(wide.conversion(pointer) == "inttoptr", "integer to pointer")
    require(pointer.conversion(real) == "", "invalid pointer conversion")
    require(text.conversion(signed) == "", "invalid string conversion")
    require(real.llvm == "float" && double.llvm == "double", "float representations")
    require(real.bits == 32 && double.bits == 64, "float widths")
    require(real.arithmetic("+") == "fadd" && real.arithmetic("%") == "frem", "float arithmetic")
    require(real.arithmetic("&") == "", "no float bitwise operations")
    require(real.comparison("!=") == "fcmp une", "unordered float inequality")
    require(real.comparison("<=") == "fcmp ole", "ordered float comparison")
    require(boolean.llvm == "i1" && boolean.bits == 1, "boolean representation")
    require(pointer.llvm == "ptr" && text.llvm == "{ptr, i64}", "pointer and string representations")
    require(nothing.llvm == "void", "void representation")
    require(boolean.arithmetic("+") == "" && pointer.comparison("<") == "", "invalid scalar operations")
    require(text.comparison("==") == "", "strings use runtime equality")
    require(types.registry.lookup("int").llvm == "", "unknown type")
    require(types.registry.lookup("int16[]").llvm == "", "arrays are not primitive types")
    require(signed.lower_bound() == "-32768" && signed.upper_bound() == "32768", "int16 bounds")
    require(unsigned.maximum(false) == uint64(65535), "uint16 maximum")
    require(wide.lower_bound() == "-9223372036854775808", "int64 minimum")
    require(types.registry.lookup("uint64").upper_bound() == "18446744073709551616", "uint64 exclusive upper bound")
    require(types.registry.lookup("uint64").maximum(false) == uint64(18446744073709551615), "uint64 maximum")
    core.print("Passed compiler type implementation checks.")
    return 0
