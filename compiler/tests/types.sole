import core
import primitives.registry as registry
import codegen.llvm.scalars as scalars
import primitives.definition as scalar_definition


def require(condition: bool, description: str) -> void:
    """TODO: Document this function."""
    if not condition:
        core.print("FAIL: " + description)
        core.exit(1)


def check_integer(name: str, llvm: str, bits: int64, unsigned: bool) -> void:
    """TODO: Document this function."""
    definition: scalar_definition.Type = registry.lookup(name)
    require(scalar_definition.known(definition) && definition.name == name, name + " primitive identity")
    require(scalars.representation(definition) == llvm, name + " representation")
    require(scalar_definition.integer(definition) && not scalar_definition.floating(definition), name + " category")
    require(definition.bits == bits && definition.unsigned == unsigned, name + " width and signedness")
    require(scalars.arithmetic(definition, "+") == "add", name + " addition")
    require(scalars.arithmetic(definition, "-") == "sub", name + " subtraction")
    require(scalars.arithmetic(definition, "*") == "mul", name + " multiplication")
    require(scalars.arithmetic(definition, "&") == "and", name + " bitwise and")
    require(scalars.arithmetic(definition, "|") == "or", name + " bitwise or")
    require(scalars.arithmetic(definition, "^") == "xor", name + " bitwise xor")
    require(scalars.arithmetic(definition, "<<") == "shl", name + " left shift")
    require(scalars.comparison(definition, "==") == "icmp eq", name + " equality")
    require(scalars.comparison(definition, "!=") == "icmp ne", name + " inequality")
    if unsigned:
        require(scalars.arithmetic(definition, "/") == "udiv", name + " division")
        require(scalars.arithmetic(definition, "%") == "urem", name + " remainder")
        require(scalars.arithmetic(definition, ">>") == "lshr", name + " right shift")
        require(scalars.comparison(definition, "<") == "icmp ult", name + " ordering")
        require(scalar_definition.lower_bound(definition) == "0", name + " lower bound")
    else:
        require(scalars.arithmetic(definition, "/") == "sdiv", name + " division")
        require(scalars.arithmetic(definition, "%") == "srem", name + " remainder")
        require(scalars.arithmetic(definition, ">>") == "ashr", name + " right shift")
        require(scalars.comparison(definition, "<") == "icmp slt", name + " ordering")
        require(scalar_definition.maximum(definition, true) == scalar_definition.maximum(definition, false) + 1, name + " signed limits")


def main() -> int32:
    """TODO: Document this function."""
    check_integer("int8", "i8", 8, false)
    check_integer("int16", "i16", 16, false)
    check_integer("int32", "i32", 32, false)
    check_integer("int64", "i64", 64, false)
    check_integer("uint8", "i8", 8, true)
    check_integer("uint16", "i16", 16, true)
    check_integer("uint32", "i32", 32, true)
    check_integer("uint64", "i64", 64, true)
    signed: scalar_definition.Type = registry.lookup("int16")
    unsigned: scalar_definition.Type = registry.lookup("uint16")
    wide: scalar_definition.Type = registry.lookup("int64")
    narrow: scalar_definition.Type = registry.lookup("int8")
    real: scalar_definition.Type = registry.lookup("float32")
    double: scalar_definition.Type = registry.lookup("float64")
    boolean: scalar_definition.Type = registry.lookup("bool")
    pointer: scalar_definition.Type = registry.lookup("ptr")
    text: scalar_definition.Type = registry.lookup("str")
    nothing: scalar_definition.Type = registry.lookup("void")
    require(scalars.conversion(signed, unsigned) == "identity", "equal-width conversion")
    require(scalars.conversion(signed, wide) == "sext", "signed extension")
    require(scalars.conversion(unsigned, wide) == "zext", "unsigned extension")
    require(scalars.conversion(signed, narrow) == "trunc", "integer truncation")
    require(scalars.conversion(signed, real) == "sitofp", "signed to float")
    require(scalars.conversion(unsigned, real) == "uitofp", "unsigned to float")
    require(scalars.conversion(real, signed) == "fptosi", "float to signed")
    require(scalars.conversion(real, unsigned) == "fptoui", "float to unsigned")
    require(scalars.conversion(real, double) == "fpext", "float extension")
    require(scalars.conversion(double, real) == "fptrunc", "float truncation")
    require(scalars.conversion(boolean, wide) == "zext", "boolean extension")
    require(scalars.conversion(signed, boolean) == "icmp ne", "integer to boolean")
    require(scalars.conversion(real, boolean) == "fcmp une", "float to boolean")
    require(scalars.conversion(pointer, wide) == "ptrtoint", "pointer to integer")
    require(scalars.conversion(wide, pointer) == "inttoptr", "integer to pointer")
    require(scalars.conversion(pointer, real) == "", "invalid pointer conversion")
    require(scalars.conversion(text, signed) == "", "invalid string conversion")
    require(scalars.representation(real) == "float" && scalars.representation(double) == "double", "float representations")
    require(real.bits == 32 && double.bits == 64, "float widths")
    require(scalars.arithmetic(real, "+") == "fadd" && scalars.arithmetic(real, "%") == "frem", "float arithmetic")
    require(scalars.arithmetic(real, "&") == "", "no float bitwise operations")
    require(scalars.comparison(real, "!=") == "fcmp une", "unordered float inequality")
    require(scalars.comparison(real, "<=") == "fcmp ole", "ordered float comparison")
    require(scalars.representation(boolean) == "i1" && boolean.bits == 1, "boolean representation")
    require(scalars.representation(pointer) == "ptr" && scalars.representation(text) == "{ptr, i64}", "pointer and string representations")
    require(scalar_definition.known(nothing) && scalars.representation(nothing) == "void", "void representation")
    require(scalars.arithmetic(boolean, "+") == "" && scalars.comparison(pointer, "<") == "", "invalid scalar operations")
    require(scalars.comparison(text, "==") == "", "strings use runtime equality")
    require(not scalar_definition.known(registry.lookup("int")), "unknown type")
    require(not scalar_definition.known(registry.lookup("int16[]")), "arrays are not primitive types")
    require(scalars.representation(registry.lookup("int")) == "", "unknown representation")
    require(scalar_definition.lower_bound(signed) == "-32768" && scalar_definition.upper_bound(signed) == "32768", "int16 bounds")
    require(scalar_definition.maximum(unsigned, false) == uint64(65535), "uint16 maximum")
    require(scalar_definition.lower_bound(wide) == "-9223372036854775808", "int64 minimum")
    require(scalar_definition.upper_bound(registry.lookup("uint64")) == "18446744073709551616", "uint64 exclusive upper bound")
    require(scalar_definition.maximum(registry.lookup("uint64"), false) == uint64(18446744073709551615), "uint64 maximum")
    core.print("Passed compiler type implementation checks.")
    return 0
