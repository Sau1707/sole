import syntax.lexer.tokens as token_model


struct NamedImport:
    module_name: str
    exported_name: str
    local_name: str
    position: int64
    dependency: int64


# Track a module's declarations, imports, and loading state.
struct ModuleInfo:
    path: str
    prefix: str
    tokens: token_model.Tokens
    names: str[]
    aliases: str[]
    dependencies: int64[]
    removed: bool[]
    active: bool
    intrinsics: str[]
    named_imports: NamedImport[]
