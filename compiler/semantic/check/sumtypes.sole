import core
import semantic.model as model
import diagnostics.report as report
import codegen.llvm.context as context
import codegen.llvm.types as llvm_types
import semantic.types.query as type_query
import semantic.resolve.symbols as symbols
import semantic.resolve.builtins as builtins


def validate(state: context.State) -> void:
    """TODO: Document this function."""
    saved_position: int64 = state.tokens.position
    for i in range(core.len(state.sums)):
        info: model.SumInfo = state.sums[i]
        state.tokens.position = info.position
        if symbols.sum_index(state, info.name) != i || symbols.record_index(state, info.name) >= 0 || symbols.function_index(state, info.name) >= 0 || builtins.reserved_type_name(info.name):
            report.fail_at(state, "duplicate or reserved type: " + info.name)
        if core.len(info.variants) == 0:
            report.fail_at(state, "sum type must have at least one member")
        for v in range(core.len(info.variants)):
            variant: model.VariantInfo = info.variants[v]
            state.tokens.position = variant.position
            for previous in range(v):
                if info.variants[previous].name == variant.name:
                    report.fail_at(state, "duplicate member: " + variant.name)
            for p in range(core.len(variant.types)):
                typ: str = variant.types[p]
                if type_query.element_type(typ) == "void":
                    report.fail_at(state, "void cannot be a payload type")
                llvm_types.llvm_type(state, typ)
                for q in range(p):
                    if variant.names[q] == variant.names[p]:
                        report.fail_at(state, "duplicate payload field: " + variant.names[p])
    state.tokens.position = saved_position


def check_layout(state: context.State, typ: str, path: str[]) -> void:
    """TODO: Document this function."""
    saved_position: int64 = state.tokens.position
    if type_query.dynamic_type(typ):
        return
    typ = type_query.element_type(typ)
    ri: int64 = symbols.record_index(state, typ)
    si: int64 = symbols.sum_index(state, typ)
    if si >= 0:
        state.tokens.position = state.sums[si].position
    if ri >= 0 && state.records[ri].kind == "class":
        return
    if ri < 0 && (si < 0 || state.sums[si].kind == "enum"):
        state.tokens.position = saved_position
        return
    for i in range(core.len(path)):
        if path[i] == typ:
            report.fail_at(state, "recursive value layout: " + typ)
    next_path: str[] = []
    for i in range(core.len(path)):
        core.append(next_path, path[i])
    core.append(next_path, typ)
    if ri >= 0:
        for f in range(core.len(state.records[ri].types)):
            check_layout(state, state.records[ri].types[f], next_path)
    else:
        for v in range(core.len(state.sums[si].variants)):
            for p in range(core.len(state.sums[si].variants[v].types)):
                state.tokens.position = state.sums[si].variants[v].position
                check_layout(state, state.sums[si].variants[v].types[p], next_path)
    state.tokens.position = saved_position
