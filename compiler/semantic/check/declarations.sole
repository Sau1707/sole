import core
import semantic.model as model
import diagnostics.report as report
import codegen.llvm.context as context
import codegen.llvm.types as llvm_types
import semantic.types.query as type_query
import semantic.resolve.symbols as symbols
import semantic.check.layouts as layouts
import semantic.resolve.builtins as builtins


def validate(state: context.State) -> void:
    """Check declaration names, field types, signatures, and record layouts."""

    # Check record names, field types, and conflicting members.
    for i in range(core.len(state.records)):
        record: model.RecordInfo = state.records[i]
        if symbols.record_index(state, record.name) != i || builtins.reserved_type_name(record.name):
            report.fail_at(state, "duplicate or reserved type: " + record.name)
        for j in range(core.len(record.names)):
            if record.types[j] == "void" || type_query.element_type(record.types[j]) == "void":
                report.fail_at(state, "void cannot be a field type")
            llvm_types.llvm_type(state, record.types[j])
            for k in range(j):
                if record.names[j] == record.names[k]:
                    report.fail_at(state, "duplicate field: " + record.names[j])

    # Walk inline record fields to reject infinite-sized value layouts.
    for layout_index in range(core.len(state.records)):
        layouts.check_layout(state, state.records[layout_index].name, [])

    # Validate function names, return types, parameters, and foreign signatures.
    for f in range(core.len(state.functions)):
        fn: model.FunctionInfo = state.functions[f]
        if symbols.function_index(state, fn.name) != f || not fn.external && builtins.reserved_name(fn.name) || symbols.record_index(state, fn.name) >= 0:
            report.fail_at(state, "duplicate or reserved function: " + fn.name)
        llvm_types.llvm_type(state, fn.result)
        if fn.external && fn.result != "void" && fn.result != "ptr" && fn.result != "bool" && not type_query.integer_type(fn.result) && not type_query.float_type(fn.result):
            report.fail_at(state, "extern results must be scalar, ptr, or void")
        for p in range(core.len(fn.types)):
            if fn.types[p] == "void" || type_query.element_type(fn.types[p]) == "void":
                report.fail_at(state, "void cannot be a parameter type")
            llvm_types.llvm_type(state, fn.types[p])
            for q in range(p):
                if fn.names[p] == fn.names[q]:
                    report.fail_at(state, "duplicate parameter")
            if fn.external && not type_query.integer_type(fn.types[p]) && not type_query.float_type(fn.types[p]) && fn.types[p] != "ptr" && fn.types[p] != "bool":
                report.fail_at(state, "extern parameters must be scalar or ptr")
