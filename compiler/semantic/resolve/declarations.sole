import core
import semantic.model as model
import diagnostics.report as report
import syntax.parser.tokens as tokens
import codegen.llvm.context as context


def parse_type(state: context.State) -> str:
    """Parse a type name with optional array brackets."""
    name: str = tokens.identifier(state)
    if tokens.accept(state, "["):
        name = name + "["
        if tokens.peek(state) != "]":
            if state.tokens.kind[state.tokens.position[0]] != 2:
                report.fail_at(state, "expected a numeric array length")
            name = name + tokens.take(state)
        tokens.expect(state, "]")
        name = name + "]"
    return name


def skip_body(state: context.State) -> void:
    """Skip a complete indented body while collecting declarations."""
    tokens.expect(state, ":")
    tokens.expect(state, "<newline>")
    tokens.expect(state, "<indent>")
    depth: int32 = 1
    while depth > 0:
        kind: int32 = state.tokens.kind[state.tokens.position[0]]
        tokens.take(state)
        if kind == 5:
            depth = depth + 1
        elif kind == 6:
            depth = depth - 1


def scan_function(state: context.State, external: bool) -> void:
    """Collect a function signature and remember where its body starts."""
    tokens.expect(state, "def")
    name: str = tokens.identifier(state)
    names: str[] = []
    types: str[] = []
    tokens.expect(state, "(")
    while tokens.peek(state) != ")":
        core.append(names, tokens.identifier(state))
        tokens.expect(state, ":")
        core.append(types, parse_type(state))
        if not tokens.accept(state, ","):
            break
    tokens.expect(state, ")")
    tokens.expect(state, "->")
    result_type: str = parse_type(state)
    core.append(state.functions, model.FunctionInfo(name, names, types, result_type, state.tokens.position[0], external))
    if external:
        tokens.expect(state, "<newline>")
    else:
        skip_body(state)


def scan(state: context.State) -> void:
    """Collect module-level functions and data-only structs."""
    while tokens.peek(state) != "<end>":
        if tokens.accept(state, "<newline>"):
            pass
        elif tokens.peek(state) == "def":
            scan_function(state, false)
        elif tokens.accept(state, "extern"):
            scan_function(state, true)
        elif tokens.accept(state, "struct"):
            record_name: str = tokens.identifier(state)
            record: model.RecordInfo = model.RecordInfo(record_name, [], [])
            core.append(state.records, record)
            tokens.expect(state, ":")
            tokens.expect(state, "<newline>")
            tokens.expect(state, "<indent>")
            tokens.skip_docstring(state)
            while tokens.peek(state) != "<dedent>":
                if tokens.peek(state) == "def":
                    report.fail_at(state, "structs cannot contain methods; use a function with an explicit parameter")
                if tokens.accept(state, "pass"):
                    tokens.expect(state, "<newline>")
                else:
                    core.append(record.names, tokens.identifier(state))
                    tokens.expect(state, ":")
                    core.append(record.types, parse_type(state))
                    tokens.expect(state, "<newline>")
            tokens.expect(state, "<dedent>")
        else:
            report.fail_at(state, "expected a function or struct declaration")
