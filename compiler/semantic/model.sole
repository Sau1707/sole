
# Describe the fields and kind of a struct or class.
struct RecordInfo:
    name: str
    kind: str
    names: str[]
    types: str[]


# Describe a function's signature and body location.
struct FunctionInfo:
    name: str
    names: str[]
    types: str[]
    result: str
    body: int64
    external: bool


struct VariantInfo:
    name: str
    names: str[]
    types: str[]
    position: int64


struct SumInfo:
    name: str
    kind: str
    variants: VariantInfo[]
    position: int64
