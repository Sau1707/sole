import core
import diagnostics.report as report
import primitives.registry as registry
import primitives.definition as definition
import syntax.lexer.characters as characters


def builtin_type(typ: str) -> bool:
    """TODO: Document this function."""
    return definition.known(registry.lookup(typ))


def array_type(typ: str) -> bool:
    """Recognize fixed-size and growable array type names."""
    return core.len(typ) > 2 && typ[core.len(typ) - 1] == 93


def element_type(typ: str) -> str:
    """Extract the base type before an array's brackets."""
    i: int64 = 0
    while i < core.len(typ) && typ[i] != 91:
        i = i + 1
    return core.slice(typ, 0, i)


def dynamic_type(typ: str) -> bool:
    """Recognize growable arrays with empty brackets."""
    return array_type(typ) && typ[core.len(typ) - 2] == 91


def integer_type(typ: str) -> bool:
    """Recognize the supported signed and unsigned integer types."""
    return definition.integer(registry.lookup(typ))


def float_type(typ: str) -> bool:
    """Recognize the supported floating-point types."""
    return definition.floating(registry.lookup(typ))


def unsigned_type(typ: str) -> bool:
    """Distinguish unsigned integer type names."""
    return registry.lookup(typ).unsigned


def decimal(text: str) -> int64:
    """Parse a bounded decimal size, allowing underscore separators."""
    result_number: int64 = 0
    for i in range(core.len(text)):
        if text[i] != 95:
            if not characters.digit(text[i]):
                report.die("expected a decimal integer: " + text)
            if result_number > 1000000000:
                report.die("decimal size is too large")
            result_number = result_number * 10 + int64(text[i] - 48)
    return result_number


def fixed_length(typ: str) -> int64:
    """Read the element count from a fixed-size array type."""
    return decimal(core.slice(typ, core.len(element_type(typ)) + 1, core.len(typ) - 1))
