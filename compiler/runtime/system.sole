import core
import os.path
import runtime.linux as linux


def fail(message: str) -> void:
    """Report a runtime failure on standard error and exit unsuccessfully."""
    text: str = "sole: " + message + "\n"
    ¢.write(2, core.cstr(text), uint64(core.len(text)))
    core.exit(1)


def error_message() -> str:
    """Copy libc's error message before another call can replace it."""
    return "" + core.from_cstr(¢.strerror(linux.errno()))


def is_file(path: ptr) -> bool:
    """Follow symlinks and recognize regular files using the platform ABI."""
    info: linux.Stat = linux.stat_buffer()
    return ¢.stat(path, core.address(info)) == 0 && (info.mode & 61440) == 32768


def home() -> str:
    """Locate compiler resources relative to the executable or explicit override."""
    configured: ptr = ¢.getenv(core.cstr("SOLE_HOME"))
    if configured != ptr(0):
        return core.from_cstr(configured)
    buffer: ptr = ¢.malloc(4096)
    if buffer == ptr(0):
        fail("out of memory")
    size: int64 = ¢.readlink(core.cstr("/proc/self/exe"), buffer, 4095)
    executable: str = ""
    if size > 0 && size < 4095:
        zero: uint8 = 0
        ¢.memcpy(ptr(uint64(buffer) + uint64(size)), core.address(zero), 1)
        executable = "" + core.from_cstr(buffer)
    ¢.free(buffer)
    if executable != "":
        directory: str = os.path.split(executable)[0]
        suffixes: str[] = ["../share/sole", ".."]
        for i in range(core.len(suffixes)):
            candidate: str = directory + suffixes[i]
            if is_file(core.cstr(candidate + "/compiler/runtime/core.ll")):
                resolved: ptr = ¢.realpath(core.cstr(candidate), ptr(0))
                if resolved != ptr(0):
                    text: str = "" + core.from_cstr(resolved)
                    ¢.free(resolved)
                    return text
    return "."


def lib_home() -> str:
    """Respect a library override, otherwise use the compiler resource tree."""
    configured: ptr = ¢.getenv(core.cstr("SOLE_LIB"))
    if configured != ptr(0):
        return core.from_cstr(configured)
    path: str = home() + "/lib"
    if core.len(path) >= 4096:
        fail("library path is too long")
    return path


def realpath(path: ptr) -> ptr:
    """Resolve a path or terminate with libc's resolution error."""
    resolved: ptr = ¢.realpath(path, ptr(0))
    if resolved == ptr(0):
        fail(error_message())
    return resolved


def same_file(first: ptr, second: ptr) -> bool:
    """Compare filesystem identity while following symlinks."""
    a: linux.Stat = linux.stat_buffer()
    b: linux.Stat = linux.stat_buffer()
    return ¢.stat(first, core.address(a)) == 0 && ¢.stat(second, core.address(b)) == 0 && a.device == b.device && a.inode == b.inode


def temp_dir() -> str:
    """Create a private temporary directory using the configured temporary root."""
    configured: ptr = ¢.getenv(core.cstr("TMPDIR"))
    root: str = "/tmp"
    if configured != ptr(0):
        root = core.from_cstr(configured)
    elif ¢.access(core.cstr("/tmp/opencode"), 2) == 0:
        root = "/tmp/opencode"
    path: ptr = core.cstr(root + "/sole-XXXXXX")
    if ¢.mkdtemp(path) == ptr(0):
        fail("cannot create temporary directory")
    return core.from_cstr(path)


def resolve_output(path: ptr) -> ptr:
    """Resolve existing outputs but reject dangling symlinks and lookup failures."""
    resolved: ptr = ¢.realpath(path, ptr(0))
    if resolved != ptr(0):
        return resolved
    if linux.errno() != 2:
        return ptr(0)
    info: linux.Stat = linux.stat_buffer()
    if ¢.lstat(path, core.address(info)) == 0:
        error: int32 = 2
        if (info.mode & 61440) == 40960:
            error = 67
        linux.set_errno(error)
        return ptr(0)
    if linux.errno() != 2:
        return ptr(0)
    return ¢.strdup(path)


def output_path(path: str) -> str:
    """Select an output destination without following a dangling symlink."""
    resolved: ptr = resolve_output(core.cstr(path))
    if resolved == ptr(0):
        error: int32 = linux.errno()
        message: str = error_message()
        if error == 67:
            message = "dangling output symlink"
        fail(path + ": " + message)
    text: str = "" + core.from_cstr(resolved)
    ¢.free(resolved)
    return text


def output_dir(output: str) -> str:
    """Create private staging storage on the output destination's filesystem."""
    path: ptr = core.cstr(os.path.split(output)[0] + ".sole-output-XXXXXX")
    if ¢.mkdtemp(path) == ptr(0):
        message: str = error_message()
        ¢.free(path)
        fail(message)
    return core.from_cstr(path)


def atomic_write_file(path: ptr, data: ptr, length: int64) -> str:
    """Replace an existing file atomically, preserving identity checks and metadata."""
    if length < 0:
        return "invalid file length"
    resolved: ptr = resolve_output(path)
    if resolved == ptr(0):
        if linux.errno() == 67:
            return "dangling output symlink"
        return error_message()
    original: linux.Stat = linux.stat_buffer()
    message: str = ""
    if ¢.stat(resolved, core.address(original)) != 0:
        message = error_message()
    elif (original.mode & 61440) != 32768:
        message = "cannot atomically format a non-regular file"
    elif original.links != 1:
        message = "cannot atomically format a file with multiple hard links"
    elif ¢.access(resolved, 2) != 0:
        message = error_message()
    if message != "":
        ¢.free(resolved)
        return message
    temporary: ptr = core.cstr(os.path.split(core.from_cstr(resolved))[0] + ".sole-format-XXXXXX")
    descriptor: int32 = ¢.mkstemp(temporary)
    if descriptor < 0:
        message = error_message()
        ¢.free(temporary)
        ¢.free(resolved)
        return message
    written: int64 = 0
    while written < length:
        count: int64 = ¢.write(descriptor, ptr(uint64(data) + uint64(written)), uint64(length - written))
        if count < 0 && linux.errno() == 4:
            continue
        if count <= 0:
            message = "short write while formatting"
            if count < 0:
                message = error_message()
            break
        written = written + count
    staged: linux.Stat = linux.stat_buffer()
    if message == "" && ¢.fstat(descriptor, core.address(staged)) != 0:
        message = error_message()
    if message == "" && (staged.uid != original.uid || staged.gid != original.gid) && ¢.fchown(descriptor, original.uid, original.gid) != 0:
        message = error_message()
    if message == "" && ¢.fchmod(descriptor, original.mode & 4095) != 0:
        message = error_message()
    if message == "" && ¢.fsync(descriptor) != 0:
        message = error_message()
    if ¢.close(descriptor) != 0 && message == "":
        message = error_message()
    current: linux.Stat = linux.stat_buffer()
    if message == "":
        if ¢.lstat(resolved, core.address(current)) != 0:
            message = error_message()
        elif current.device != original.device || current.inode != original.inode || current.links != 1:
            message = "file changed while formatting"
    if message == "" && ¢.rename(temporary, resolved) != 0:
        message = error_message()
    if message != "":
        ¢.unlink(temporary)
    ¢.free(temporary)
    ¢.free(resolved)
    return message


def process_run(executable: ptr, arguments: ptr, status: ptr) -> int32:
    """Spawn without a shell and retry interrupted waits until the child is reaped."""
    environment: ptr = linux.environment()
    if environment == ptr(0):
        return 38
    child: int32 = 0
    error: int32 = ¢.posix_spawnp(core.address(child), executable, ptr(0), ptr(0), arguments, environment)
    if error != 0:
        return error
    while ¢.waitpid(child, status, 0) < 0:
        error = linux.errno()
        if error != 4:
            return error
    return 0


def f64_bits(value: float64) -> uint64:
    """Reinterpret a native double without numeric conversion or aliasing violations."""
    bits: uint64 = 0
    ¢.memcpy(core.address(bits), core.address(value), 8)
    return bits
