struct Type:
    name: str
    bits: int64
    category: str
    unsigned: bool


def known(typ: Type) -> bool:
    return typ.category != ""


def integer(typ: Type) -> bool:
    return typ.category == "integer"


def floating(typ: Type) -> bool:
    return typ.category == "float"


def numeric(typ: Type) -> bool:
    return integer(typ) || floating(typ)


def maximum(typ: Type, negative: bool) -> uint64:
    if not typ.unsigned:
        limit: uint64 = uint64(1) << uint64(typ.bits - 1)
        if not negative:
            limit = limit - 1
        return limit
    if typ.bits < 64:
        return (uint64(1) << uint64(typ.bits)) - 1
    return uint64(18446744073709551615)


def lower_bound(typ: Type) -> str:
    if typ.unsigned:
        return "0"
    return "-" + str(uint64(1) << uint64(typ.bits - 1))


def upper_bound(typ: Type) -> str:
    if not typ.unsigned:
        return str(uint64(1) << uint64(typ.bits - 1))
    if typ.bits == 64:
        return "18446744073709551616"
    return str(uint64(1) << uint64(typ.bits))
