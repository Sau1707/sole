import primitives.ptr as scalar_ptr
import primitives.bool as scalar_bool
import primitives.void as scalar_void
import primitives.definition as scalar_definition


def lookup(name: str) -> scalar_definition.Type:
    """TODO: Document this function."""
    if name == "int8":
        return scalar_definition.Type("int8", 8, "integer", false)
    if name == "int16":
        return scalar_definition.Type("int16", 16, "integer", false)
    if name == "int32":
        return scalar_definition.Type("int32", 32, "integer", false)
    if name == "int64":
        return scalar_definition.Type("int64", 64, "integer", false)
    if name == "uint8":
        return scalar_definition.Type("uint8", 8, "integer", true)
    if name == "uint16":
        return scalar_definition.Type("uint16", 16, "integer", true)
    if name == "uint32":
        return scalar_definition.Type("uint32", 32, "integer", true)
    if name == "uint64":
        return scalar_definition.Type("uint64", 64, "integer", true)
    if name == "float32":
        return scalar_definition.Type("float32", 32, "float", false)
    if name == "float64":
        return scalar_definition.Type("float64", 64, "float", false)
    if name == "bool":
        return scalar_bool.bool().definition()
    if name == "str":
        return scalar_definition.Type("str", 0, "str", false)
    if name == "ptr":
        return scalar_ptr.ptr().definition()
    if name == "void":
        return scalar_void.void().definition()
    return scalar_definition.Type(name, 0, "", false)
