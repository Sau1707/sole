import primitives.str as scalar_str
import primitives.ptr as scalar_ptr
import primitives.int as scalar_int
import primitives.bool as scalar_bool
import primitives.void as scalar_void
import primitives.uint as scalar_uint
import primitives.float as scalar_float
import primitives.definition as scalar_definition


def lookup(name: str) -> scalar_definition.Type:
    """TODO: Document this function."""
    if name == "int8":
        return scalar_int.int8().definition()
    if name == "int16":
        return scalar_int.int16().definition()
    if name == "int32":
        return scalar_int.int32().definition()
    if name == "int64":
        return scalar_int.int64().definition()
    if name == "uint8":
        return scalar_uint.uint8().definition()
    if name == "uint16":
        return scalar_uint.uint16().definition()
    if name == "uint32":
        return scalar_uint.uint32().definition()
    if name == "uint64":
        return scalar_uint.uint64().definition()
    if name == "float32":
        return scalar_float.float32().definition()
    if name == "float64":
        return scalar_float.float64().definition()
    if name == "bool":
        return scalar_bool.bool().definition()
    if name == "str":
        return scalar_str.str().definition()
    if name == "ptr":
        return scalar_ptr.ptr().definition()
    if name == "void":
        return scalar_void.void().definition()
    return scalar_definition.Type(name, 0, "", false)
