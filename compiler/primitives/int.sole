class int8:
    def abs(self) -> int8:
        """Return the absolute value using the type's wrapping arithmetic."""
        if self < 0:
            return -self
        return self

    def min(self, other: int8) -> int8:
        """Return the smaller value, choosing other on a tie."""
        if self < other:
            return self
        return other

    def max(self, other: int8) -> int8:
        """Return the larger value, choosing other on a tie."""
        if self > other:
            return self
        return other

    def clamp(self, lower: int8, upper: int8) -> int8:
        """Apply the lower bound, then the upper bound."""
        return self.max(lower).min(upper)

    def gcd(self, other: int8) -> int8:
        """Run Euclid's algorithm on the absolute values."""
        a: int8 = self.abs()
        b: int8 = other.abs()
        while b != 0:
            remainder: int8 = a % b
            a = b
            b = remainder
        return a


