class uint8:
    def abs(self) -> uint8:
        """Return the unsigned value unchanged."""
        return self

    def min(self, other: uint8) -> uint8:
        """Return the smaller value, choosing other on a tie."""
        if self < other:
            return self
        return other

    def max(self, other: uint8) -> uint8:
        """Return the larger value, choosing other on a tie."""
        if self > other:
            return self
        return other

    def clamp(self, lower: uint8, upper: uint8) -> uint8:
        """Apply the lower bound, then the upper bound."""
        return self.max(lower).min(upper)

    def gcd(self, other: uint8) -> uint8:
        """Return the greatest common divisor using Euclid's algorithm."""
        a: uint8 = self
        b: uint8 = other
        while b != 0:
            remainder: uint8 = a % b
            a = b
            b = remainder
        return a

    def is_digit(self) -> bool:
        """Recognize ASCII decimal digits."""
        return self >= 48 && self <= 57

    def is_alpha(self) -> bool:
        """Recognize ASCII letters."""
        return self >= 65 && self <= 90 || self >= 97 && self <= 122

    def is_space(self) -> bool:
        """Recognize ASCII space and whitespace control bytes."""
        return self == 32 || self >= 9 && self <= 13

    def to_lower(self) -> uint8:
        """Lowercase ASCII letters, leaving other bytes unchanged."""
        if self >= 65 && self <= 90:
            return self + 32
        return self

    def to_upper(self) -> uint8:
        """Uppercase ASCII letters, leaving other bytes unchanged."""
        if self >= 97 && self <= 122:
            return self - 32
        return self


