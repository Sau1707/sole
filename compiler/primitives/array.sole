import core


class str_array:
    def index_of(self, value: str) -> int64:
        """Return the first matching string index, or -1 if absent."""
        for i in range(core.len(self)):
            if self[i] == value:
                return i
        return -1

    def contains(self, value: str) -> bool:
        """Return whether the string array contains value."""
        return self.index_of(value) >= 0
