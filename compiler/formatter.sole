import core


class Lines:
    starts: int64[]
    kinds: int32[]
    error: str


def scan(source: str) -> Lines:
    lines: Lines = Lines([], [], "")
    quote: uint8 = 0
    triple: bool = false
    delimiters: uint8[] = []
    depth: int64 = 0
    i: int64 = 0
    while i < core.len(source):
        start: int64 = i
        end: int64 = i
        while end < core.len(source) && source[end] != 10:
            end = end + 1
        core.append(lines.starts, start)
        first: int64 = start
        while first < end && (source[first] == 32 || source[first] == 9 || source[first] == 13):
            first = first + 1
        kind: int32 = 2
        if quote == 0 && depth == 0:
            if first == end:
                kind = 0
            elif source[first] == 35:
                if first == start:
                    kind = 1
            elif first == start:
                kind = 5
                word_end: int64 = first
                while word_end < end && source[word_end] >= 97 && source[word_end] <= 122:
                    word_end = word_end + 1
                word: str = core.slice(source, first, word_end)
                if word == "import":
                    kind = 3
                elif word == "def" || word == "class" || word == "struct" || word == "extern":
                    kind = 4
        core.append(lines.kinds, kind)
        while i < end:
            byte: uint8 = source[i]
            if quote != 0:
                if byte == 92:
                    i = i + 2
                    continue
                if byte == quote:
                    if not triple:
                        quote = 0
                    elif i + 2 < end && source[i + 1] == quote && source[i + 2] == quote:
                        quote = 0
                        i = i + 2
            elif byte == 35:
                break
            elif byte == 34 || byte == 39:
                quote = byte
                triple = i + 2 < end && source[i + 1] == byte && source[i + 2] == byte
                if triple:
                    i = i + 2
            elif byte == 40 || byte == 91:
                if depth == core.len(delimiters):
                    core.append(delimiters, byte)
                else:
                    delimiters[depth] = byte
                depth = depth + 1
            elif byte == 41 || byte == 93:
                if depth == 0:
                    lines.error = "unmatched closing delimiter"
                    return lines
                opening: uint8 = delimiters[depth - 1]
                if byte == 41 && opening != 40 || byte == 93 && opening != 91:
                    lines.error = "mismatched closing delimiter"
                    return lines
                depth = depth - 1
            i = i + 1
        if quote != 0 && not triple:
            lines.error = "unterminated string"
            return lines
        i = end
        if i < core.len(source):
            i = i + 1
    if quote != 0:
        lines.error = "unterminated triple-quoted string"
    elif depth != 0:
        lines.error = "unclosed delimiter"
    return lines


def format_source(source: str, lines: Lines) -> str:
    newline: str = "\n"
    i: int64 = 1
    while i < core.len(source):
        if source[i - 1] == 13 && source[i] == 10:
            newline = "\r\n"
            break
        i = i + 1
    parts: str[] = []
    copied: int64 = 0
    previous: int32 = 0
    i = 0
    while i < core.len(lines.kinds):
        kind: int32 = lines.kinds[i]
        if kind >= 3:
            required: bool = previous == 3 || previous == 4 || kind == 4 && previous != 0
            if previous == 3 && kind == 3:
                required = false
            if required:
                anchor: int64 = i
                while anchor > 0 && lines.kinds[anchor - 1] == 1:
                    anchor = anchor - 1
                start: int64 = anchor
                while start > 0 && lines.kinds[start - 1] == 0:
                    start = start - 1
                if anchor - start != 2:
                    core.append(parts, core.slice(source, copied, lines.starts[start]))
                    core.append(parts, newline + newline)
                    copied = lines.starts[anchor]
            previous = kind
        i = i + 1
    core.append(parts, core.slice(source, copied, core.len(source)))
    return core.join(parts)
