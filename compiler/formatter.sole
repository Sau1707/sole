import core


class Lines:
    starts: int64[]
    kinds: int32[]
    error: str


def scan(source: str) -> Lines:
    lines: Lines = Lines([], [], "")
    quote: uint8 = 0
    triple: bool = false
    delimiters: uint8[] = []
    i: int64 = 0
    while i < core.len(source):
        start: int64 = i
        end: int64 = i
        while end < core.len(source) and source[end] != 10:
            end = end + 1
        core.append(lines.starts, start)
        first: int64 = start
        while first < end and (source[first] == 32 or source[first] == 9 or source[first] == 13):
            first = first + 1
        kind: int32 = 2
        if quote == 0 and core.len(delimiters) == 0:
            if first == end:
                kind = 0
            elif source[first] == 35:
                if first == start:
                    kind = 1
            elif first == start:
                kind = 5
                word_end: int64 = first
                while word_end < end and source[word_end] >= 97 and source[word_end] <= 122:
                    word_end = word_end + 1
                word: str = core.slice(source, first, word_end)
                if word == "import":
                    kind = 3
                elif word == "def" or word == "class" or word == "struct" or word == "extern":
                    kind = 4
        core.append(lines.kinds, kind)
        while i < end:
            byte: uint8 = source[i]
            if quote != 0:
                if byte == 92:
                    i = i + 2
                    continue
                if byte == quote:
                    if not triple:
                        quote = 0
                    elif i + 2 < end and source[i + 1] == quote and source[i + 2] == quote:
                        quote = 0
                        i = i + 2
            elif byte == 35:
                break
            elif byte == 34 or byte == 39:
                quote = byte
                triple = i + 2 < end and source[i + 1] == byte and source[i + 2] == byte
                if triple:
                    i = i + 2
            elif byte == 40 or byte == 91:
                core.append(delimiters, byte)
            elif byte == 41 or byte == 93:
                count: int64 = core.len(delimiters)
                if count == 0:
                    lines.error = "unmatched closing delimiter"
                    return lines
                opening: uint8 = delimiters[count - 1]
                if byte == 41 and opening != 40 or byte == 93 and opening != 91:
                    lines.error = "mismatched closing delimiter"
                    return lines
                remaining: uint8[] = []
                d: int64 = 0
                while d < count - 1:
                    core.append(remaining, delimiters[d])
                    d = d + 1
                delimiters = remaining
            i = i + 1
        if quote != 0 and not triple:
            lines.error = "unterminated string"
            return lines
        i = end
        if i < core.len(source):
            i = i + 1
    if quote != 0:
        lines.error = "unterminated triple-quoted string"
    elif core.len(delimiters) != 0:
        lines.error = "unclosed delimiter"
    return lines


def format_source(source: str, lines: Lines) -> str:
    newline: str = "\n"
    i: int64 = 1
    while i < core.len(source):
        if source[i - 1] == 13 and source[i] == 10:
            newline = "\r\n"
            break
        i = i + 1
    parts: str[] = []
    copied: int64 = 0
    previous: int32 = 0
    i = 0
    while i < core.len(lines.kinds):
        kind: int32 = lines.kinds[i]
        if kind >= 3:
            required: bool = previous == 3 or previous == 4 or kind == 4 and previous != 0
            if previous == 3 and kind == 3:
                required = false
            if required:
                anchor: int64 = i
                while anchor > 0 and lines.kinds[anchor - 1] == 1:
                    anchor = anchor - 1
                start: int64 = anchor
                while start > 0 and lines.kinds[start - 1] == 0:
                    start = start - 1
                if anchor - start != 2:
                    core.append(parts, core.slice(source, copied, lines.starts[start]))
                    core.append(parts, newline + newline)
                    copied = lines.starts[anchor]
            previous = kind
        i = i + 1
    core.append(parts, core.slice(source, copied, core.len(source)))
    return core.join(parts)
