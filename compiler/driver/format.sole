import core
import formatter
import wrappers.system


def main() -> int32:
    if core.arg_count() < 3:
        core.print("Usage: sole format [--check] file.sole ...")
        return 1
    check: bool = core.arg(2) == "--check"
    first: int64 = 2
    if check:
        first = 3
    if first == core.arg_count():
        core.print("error: expected at least one .sole file")
        return 1
    i: int64 = first
    while i < core.arg_count():
        path: str = core.arg(i)
        if core.len(path) < 5 || core.slice(path, core.len(path) - 5, core.len(path)) != ".sole":
            core.print("error: expected a .sole file: " + path)
            return 1
        i = i + 1
    status: int32 = 0
    i = first
    while i < core.arg_count():
        path: str = core.arg(i)
        source: str = core.read_file(path)
        lines: formatter.Lines = formatter.scan(source)
        if lines.error != "":
            core.print(path + ": error: " + lines.error)
            status = 1
        else:
            formatted: str = formatter.format_source(source, lines)
            if formatted != source:
                if check:
                    core.print(path + ": needs formatting")
                    status = 1
                else:
                    error: ptr = wrappers.system.sole_rt_atomic_write_file(core.cstr(path), core.cstr(formatted), core.len(formatted))
                    if error != ptr(0):
                        core.print(path + ": error: " + core.from_cstr(error))
                        status = 1
                    else:
                        core.print("Formatted " + path)
        i = i + 1
    return status
