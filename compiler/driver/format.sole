import core
import strings
import files
import syntax.formatter as formatter


def main() -> int32:
    """Format source files or check them without writing changes."""
    if core.arg_count() < 3:
        core.print("Usage: sole format [--check] file.sole ...")
        return 1
    check: bool = core.arg(2) == "--check"
    first: int64 = 2
    if check:
        first = 3
    if first == core.arg_count():
        core.print("error: expected at least one .sole file")
        return 1
    for i in range(first, core.arg_count()):
        path: str = core.arg(i)
        if not strings.ends_with(path, ".sole"):
            core.print("error: expected a .sole file: " + path)
            return 1
    status: int32 = 0
    for i in range(first, core.arg_count()):
        path: str = core.arg(i)
        source: str = core.read_file(path)
        lines: formatter.Lines = formatter.scan(source)
        if lines.error != "":
            core.print(path + ": error: " + lines.error)
            status = 1
        else:
            formatted: str = formatter.format_source(source, lines)
            if formatted != source:
                if check:
                    core.print(path + ": needs formatting")
                    status = 1
                else:
                    error: str = files.atomic_write(path, formatted)
                    if error != "":
                        core.print(path + ": error: " + error)
                        status = 1
                    else:
                        core.print("Formatted " + path)
    return status
