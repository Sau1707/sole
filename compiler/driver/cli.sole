import core
import driver.pipeline as pipeline
import driver.format
import driver.syntax
import driver.linker
import wrappers.libc
import codegen.llvm.target as target
import wrappers.system
import diagnostics.report as diagnostics


def output_error(output: str, inputs: str[]) -> str:
    i: int64 = 0
    while i < core.len(inputs):
        input_path: str = inputs[i]
        if output == input_path || wrappers.system.sole_rt_same_file(core.cstr(input_path), core.cstr(output)) != 0:
            return "output path must not overwrite the source file: " + input_path
        i = i + 1
    return ""


def cleanup(temporary: str) -> void:
    wrappers.libc.unlink(core.cstr(temporary + "/program.o"))
    wrappers.libc.unlink(core.cstr(temporary + "/program"))
    if wrappers.libc.rmdir(core.cstr(temporary)) != 0:
        core.print("sole: warning: cannot remove temporary directory: " + temporary)


# Parse command-line options and dispatch compilation, linking, or execution.
def main() -> int32:
    if core.arg_count() == 2 && core.arg(1) == "--version":
        core.print("sole 0.0.6 (self-hosted)")
        return 0
    if core.arg_count() >= 2 && core.arg(1) == "format":
        return driver.format.main()
    if core.arg_count() >= 2 && core.arg(1) == "syntax":
        return driver.syntax.main()
    if core.arg_count() < 3:
        core.print("Usage: sole build|check|run file.sole [-o output] [--target native] [--emit binary|llvm|object] [--link library] [-O0..3]")
        core.print("       sole format [--check] file.sole ...")
        core.print("       sole syntax [--grammar GRAMMAR.ebnf] file.sole ...")
        return 1
    # Read the command, source path, and compilation options.
    command: str = core.arg(1)
    if command != "build" && command != "check" && command != "run":
        diagnostics.die("unknown command: " + command)
    filename: str = core.arg(2)
    output: str = ""
    emission: str = "binary"
    libraries: str[] = []
    level: int32 = 2
    i: int64 = 3
    while i < core.arg_count():
        option: str = core.arg(i)
        if option == "-O0" || option == "-O1" || option == "-O2" || option == "-O3":
            level = int32(option[2] - 48)
        else:
            if i + 1 >= core.arg_count():
                diagnostics.die("missing value for " + option)
            value: str = core.arg(i + 1)
            if option == "-o" || option == "--output":
                output = value
            elif option == "--target":
                if value != "native":
                    diagnostics.die("unknown target: " + value)
            elif option == "--emit":
                if value != "binary" && value != "llvm" && value != "object":
                    diagnostics.die("unknown emission: " + value)
                emission = value
            elif option == "--link":
                core.append(libraries, value)
            else:
                diagnostics.die("unknown option: " + option)
            i = i + 1
        i = i + 1
    if command == "run" && emission != "binary":
        diagnostics.die("run requires binary emission")
    # Generate LLVM IR and handle validation-only requests.
    home: str = core.from_cstr(wrappers.system.sole_rt_home())
    contents: str = core.read_file(filename)
    compiled: pipeline.Compilation = pipeline.generate(filename, contents, home)
    ir_text: str = compiled.ir
    if command == "check":
        check_error: str = target.llvm_object(ir_text, "", 0, true)
        if check_error != "":
            diagnostics.die(check_error)
        core.print(filename + ": OK")
        return 0
    # Select an output path without overwriting the input source.
    suffix: str = ""
    if emission == "llvm":
        suffix = ".ll"
    elif emission == "object":
        suffix = ".o"
    if output == "":
        output = driver.linker.default_output(filename, suffix)
    protection_error: str = output_error(output, compiled.inputs)
    if protection_error != "":
        diagnostics.die(protection_error)
    # Emit IR or an object directly, or link a native executable.
    if emission == "llvm":
        ir_error: str = target.llvm_object(ir_text, "", 0, true)
        if ir_error != "":
            diagnostics.die(ir_error)
        core.write_file(output, ir_text)
    elif emission == "object":
        object_error: str = target.llvm_object(ir_text, output, level, false)
        if object_error != "":
            diagnostics.die(object_error)
    else:
        destination: str = output
        temporary: str = ""
        if command == "run":
            temporary = core.from_cstr(wrappers.system.sole_rt_temp_dir())
        else:
            destination = core.from_cstr(wrappers.system.sole_rt_output_path(core.cstr(output)))
            protection_error = output_error(destination, compiled.inputs)
            if protection_error != "":
                diagnostics.die(protection_error)
            temporary = core.from_cstr(wrappers.system.sole_rt_output_dir(core.cstr(destination)))
        object_path: str = temporary + "/program.o"
        program_path: str = temporary + "/program"
        native_error: str = target.llvm_object(ir_text, object_path, level, false)
        if native_error != "":
            cleanup(temporary)
            diagnostics.die(native_error)
        runtime_path: str = home + "/lib/runtime/system.c"
        link_command: str = driver.linker.native_linker() + " " + driver.linker.shell_quote(object_path) + " " + driver.linker.shell_quote(runtime_path) + " -lm"
        l: int64 = 0
        while l < core.len(libraries):
            link_command = link_command + " " + driver.linker.shell_quote("-l" + libraries[l])
            l = l + 1
        link_command = link_command + " -o " + driver.linker.shell_quote(program_path)
        status: int32 = wrappers.libc.system(core.cstr(link_command))
        if status != 0:
            cleanup(temporary)
            diagnostics.die("linking failed")
        if command == "run":
            # Run the temporary executable and preserve its exit status.
            run_command: str = driver.linker.shell_quote(program_path)
            status = wrappers.libc.system(core.cstr(run_command))
            cleanup(temporary)
            if (status & 127) != 0:
                return 128 + (status & 127)
            return (status >> 8) & 255
        protection_error = output_error(destination, compiled.inputs)
        if protection_error != "":
            cleanup(temporary)
            diagnostics.die(protection_error)
        if wrappers.libc.rename(core.cstr(program_path), core.cstr(destination)) != 0:
            cleanup(temporary)
            diagnostics.die("cannot publish executable: " + output)
        cleanup(temporary)
    core.print("Built " + output)
    return 0
