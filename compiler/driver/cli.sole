import core
import env
import files
import os.path
import process
import runtime.system as system
import driver.pipeline as pipeline
import codegen.llvm.target as target
import diagnostics.report as diagnostics


def output_error(output: str, inputs: str[]) -> str:
    """TODO: Document this function."""
    for i in range(core.len(inputs)):
        input_path: str = inputs[i]
        if output == input_path || files.same_file(input_path, output):
            return "output path must not overwrite the source file: " + input_path
    return ""


def cleanup(temporary: str) -> void:
    """TODO: Document this function."""
    ¢.unlink(core.cstr(temporary + "/program.o"))
    ¢.unlink(core.cstr(temporary + "/program"))
    if ¢.rmdir(core.cstr(temporary)) != 0:
        core.print("sole: warning: cannot remove temporary directory: " + temporary)


def main() -> int32:
    """Parse command-line options and dispatch compilation, linking, or execution."""
    if core.arg_count() == 2 && core.arg(1) == "--version":
        core.print("sole 0.0.13 (self-hosted)")
        return 0
    if core.arg_count() < 3:
        core.print("Usage: sole build|check|run file.sole [-o output] [--emit binary|llvm|object] [--link library] [-O0..3]")
        return 1

    # Read the command, source path, and compilation options.
    command: str = core.arg(1)
    if command != "build" && command != "check" && command != "run":
        diagnostics.die("unknown command: " + command)
    filename: str = core.arg(2)
    output: str = ""
    emission: str = "binary"
    libraries: str[] = []
    level: int32 = 2
    i: int64 = 3
    while i < core.arg_count():
        option: str = core.arg(i)
        if option == "-O0" || option == "-O1" || option == "-O2" || option == "-O3":
            level = int32(option[2] - 48)
        else:
            if i + 1 >= core.arg_count():
                diagnostics.die("missing value for " + option)
            value: str = core.arg(i + 1)
            if option == "-o":
                output = value
            elif option == "--emit":
                if value != "binary" && value != "llvm" && value != "object":
                    diagnostics.die("unknown emission: " + value)
                emission = value
            elif option == "--link":
                core.append(libraries, value)
            else:
                diagnostics.die("unknown option: " + option)
            i = i + 1
        i = i + 1
    if command == "run" && emission != "binary":
        diagnostics.die("run requires binary emission")

    # Generate LLVM IR and handle validation-only requests.
    home: str = system.home()
    contents: str = core.read_file(filename)
    compiled: pipeline.Compilation = pipeline.generate(filename, contents, home)
    ir_text: str = compiled.ir
    if command == "check":
        check_error: str = target.llvm_object(ir_text, "", 0, true)
        if check_error != "":
            diagnostics.die(check_error)
        core.print(filename + ": OK")
        return 0

    # Select an output path without overwriting the input source.
    suffix: str = ""
    if emission == "llvm":
        suffix = ".ll"
    elif emission == "object":
        suffix = ".o"
    if output == "":
        output = os.path.replace_suffix(filename, ".sole", suffix)
    protection_error: str = output_error(output, compiled.inputs)
    if protection_error != "":
        diagnostics.die(protection_error)

    # Emit IR or an object directly, or link a native executable.
    if emission == "llvm":
        ir_error: str = target.llvm_object(ir_text, "", 0, true)
        if ir_error != "":
            diagnostics.die(ir_error)
        core.write_file(output, ir_text)
    elif emission == "object":
        object_error: str = target.llvm_object(ir_text, output, level, false)
        if object_error != "":
            diagnostics.die(object_error)
    else:
        destination: str = output
        temporary: str = ""
        if command == "run":
            temporary = system.temp_dir()
        else:
            destination = system.output_path(output)
            protection_error = output_error(destination, compiled.inputs)
            if protection_error != "":
                diagnostics.die(protection_error)
            temporary = system.output_dir(destination)
        object_path: str = temporary + "/program.o"
        program_path: str = temporary + "/program"
        native_error: str = target.llvm_object(ir_text, object_path, level, false)
        if native_error != "":
            cleanup(temporary)
            diagnostics.die(native_error)
        link_arguments: str[] = [object_path, "-lm", "-ldl"]
        for l in range(core.len(libraries)):
            core.append(link_arguments, "-l" + libraries[l])
        core.append(link_arguments, "-o")
        core.append(link_arguments, program_path)
        linked: process.Result = process.run(env.get("SOLE_CC", "cc"), link_arguments)
        if linked.error != "" || linked.signal != 0 || linked.exit_code != 0:
            cleanup(temporary)
            diagnostics.die("linking failed")
        if command == "run":

            # Run the temporary executable and preserve its exit status.
            result: process.Result = process.run(program_path, [])
            cleanup(temporary)
            if result.error != "":
                diagnostics.die("cannot run program: " + result.error)
            if result.signal != 0:
                return 128 + result.signal
            return result.exit_code
        protection_error = output_error(destination, compiled.inputs)
        if protection_error != "":
            cleanup(temporary)
            diagnostics.die(protection_error)
        if ¢.rename(core.cstr(program_path), core.cstr(destination)) != 0:
            cleanup(temporary)
            diagnostics.die("cannot publish executable: " + output)
        cleanup(temporary)
    core.print("Built " + output)
    return 0
