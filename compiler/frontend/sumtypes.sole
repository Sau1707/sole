import core
import backend.ir
import backend.types
import frontend.model
import frontend.types
import frontend.symbols
import frontend.builtins
import frontend.diagnostics


def variant_index(state: frontend.model.State, info: frontend.model.SumInfo, name: str) -> int64:
    i: int64 = 0
    while i < core.len(info.variants):
        if info.variants[i].name == name:
            return i
        i = i + 1
    frontend.diagnostics.fail_at(state, "unknown member '" + name + "' for " + info.name)
    return -1


def payload_offset(info: frontend.model.SumInfo, variant: int64) -> int64:
    offset: int64 = 1
    i: int64 = 0
    while i < variant:
        offset = offset + core.len(info.variants[i].types)
        i = i + 1
    return offset


def construct(state: frontend.model.State, info: frontend.model.SumInfo, variant: int64, values: frontend.model.Value[]) -> frontend.model.Value:
    if core.len(values) != core.len(info.variants[variant].types):
        frontend.diagnostics.fail_at(state, "wrong number of variant payloads")
    aggregate: str = backend.ir.instruction(state, "insertvalue %" + info.name + " zeroinitializer, i32 " + str(variant) + ", 0")
    offset: int64 = payload_offset(info, variant)
    i: int64 = 0
    while i < core.len(values):
        aggregate = backend.ir.instruction(state, "insertvalue %" + info.name + " " + aggregate + ", " + backend.ir.typed(state, values[i]) + ", " + str(offset + i))
        i = i + 1
    return frontend.model.Value(info.name, aggregate, "")


def validate(state: frontend.model.State) -> void:
    saved_position: int64 = state.tokens.position
    i: int64 = 0
    while i < core.len(state.sums):
        info: frontend.model.SumInfo = state.sums[i]
        state.tokens.position = info.position
        if frontend.symbols.sum_index(state, info.name) != i || frontend.symbols.record_index(state, info.name) >= 0 || frontend.symbols.function_index(state, info.name) >= 0 || frontend.builtins.reserved_type_name(info.name):
            frontend.diagnostics.fail_at(state, "duplicate or reserved type: " + info.name)
        if core.len(info.variants) == 0:
            frontend.diagnostics.fail_at(state, "sum type must have at least one member")
        v: int64 = 0
        while v < core.len(info.variants):
            variant: frontend.model.VariantInfo = info.variants[v]
            state.tokens.position = variant.position
            previous: int64 = 0
            while previous < v:
                if info.variants[previous].name == variant.name:
                    frontend.diagnostics.fail_at(state, "duplicate member: " + variant.name)
                previous = previous + 1
            p: int64 = 0
            while p < core.len(variant.types):
                typ: str = variant.types[p]
                if frontend.types.element_type(typ) == "void":
                    frontend.diagnostics.fail_at(state, "void cannot be a payload type")
                backend.types.llvm_type(state, typ)
                q: int64 = 0
                while q < p:
                    if variant.names[q] == variant.names[p]:
                        frontend.diagnostics.fail_at(state, "duplicate payload field: " + variant.names[p])
                    q = q + 1
                p = p + 1
            v = v + 1
        i = i + 1
    state.tokens.position = saved_position


def check_layout(state: frontend.model.State, typ: str, path: str[]) -> void:
    saved_position: int64 = state.tokens.position
    if frontend.types.dynamic_type(typ):
        return
    typ = frontend.types.element_type(typ)
    ri: int64 = frontend.symbols.record_index(state, typ)
    si: int64 = frontend.symbols.sum_index(state, typ)
    if si >= 0:
        state.tokens.position = state.sums[si].position
    if ri >= 0 && state.records[ri].kind == "class":
        return
    if ri < 0 && (si < 0 || state.sums[si].kind == "enum"):
        state.tokens.position = saved_position
        return
    i: int64 = 0
    while i < core.len(path):
        if path[i] == typ:
            frontend.diagnostics.fail_at(state, "recursive value layout: " + typ)
        i = i + 1
    next_path: str[] = []
    i = 0
    while i < core.len(path):
        core.append(next_path, path[i])
        i = i + 1
    core.append(next_path, typ)
    if ri >= 0:
        f: int64 = 0
        while f < core.len(state.records[ri].types):
            check_layout(state, state.records[ri].types[f], next_path)
            f = f + 1
    else:
        v: int64 = 0
        while v < core.len(state.sums[si].variants):
            p: int64 = 0
            while p < core.len(state.sums[si].variants[v].types):
                state.tokens.position = state.sums[si].variants[v].position
                check_layout(state, state.sums[si].variants[v].types[p], next_path)
                p = p + 1
            v = v + 1
    state.tokens.position = saved_position
