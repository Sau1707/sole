import core
import backend.ir
import backend.literals
import backend.locals
import frontend.declarations
import frontend.diagnostics
import frontend.expressions
import frontend.model
import frontend.tokens


# Compile an indented block and expire its local declarations.
def compile_block(state: frontend.model.State) -> void:
    frontend.tokens.expect(state, ":")
    frontend.tokens.expect(state, "<newline>")
    frontend.tokens.expect(state, "<indent>")
    frontend.tokens.skip_docstring(state)
    state.depth = state.depth + 1
    while frontend.tokens.peek(state) != "<dedent>":
        if state.ended:
            frontend.diagnostics.fail_at(state, "unreachable statement")
        statement(state)
    frontend.tokens.expect(state, "<dedent>")
    i: int64 = 0
    while i < core.len(state.depths):
        if state.depths[i] == state.depth:
            state.depths[i] = -1
        i = i + 1
    state.depth = state.depth - 1


# Emit conditional branches and track whether every branch terminates.
def compile_if(state: frontend.model.State) -> void:
    condition: frontend.model.Value = backend.literals.coerce(state, frontend.expressions.expression(state, 0, "bool"), "bool")
    yes: str = backend.ir.fresh(state)
    no: str = backend.ir.fresh(state)
    end: str = backend.ir.fresh(state)
    backend.ir.emit(state, "br i1 " + condition.value + ", label %" + yes + ", label %" + no)
    backend.ir.block_label(state, yes)
    compile_block(state)
    yes_ended: bool = state.ended
    if not yes_ended:
        backend.ir.emit(state, "br label %" + end)
    backend.ir.block_label(state, no)
    if frontend.tokens.accept(state, "elif"):
        compile_if(state)
    elif frontend.tokens.accept(state, "else"):
        compile_block(state)
    no_ended: bool = state.ended
    if not no_ended:
        backend.ir.emit(state, "br label %" + end)
    backend.ir.block_label(state, end)
    if yes_ended and no_ended:
        backend.ir.emit(state, "unreachable")
        state.ended = true


# Copy a loop-target stack without its final entry.
def without_last(items: str[]) -> str[]:
    result_items: str[] = []
    i: int64 = 0
    while i + 1 < core.len(items):
        core.append(result_items, items[i])
        i = i + 1
    return result_items


# Parse and lower control flow, declarations, assignments, and calls.
def statement(state: frontend.model.State) -> void:
    if frontend.tokens.accept(state, "if"):
        compile_if(state)
    elif frontend.tokens.accept(state, "while"):
        test_label: str = backend.ir.fresh(state)
        body_label: str = backend.ir.fresh(state)
        end_label: str = backend.ir.fresh(state)
        backend.ir.emit(state, "br label %" + test_label)
        backend.ir.block_label(state, test_label)
        condition: frontend.model.Value = backend.literals.coerce(state, frontend.expressions.expression(state, 0, "bool"), "bool")
        backend.ir.emit(state, "br i1 " + condition.value + ", label %" + body_label + ", label %" + end_label)
        backend.ir.block_label(state, body_label)
        core.append(state.loop_tests, test_label)
        core.append(state.loop_ends, end_label)
        compile_block(state)
        state.loop_tests = without_last(state.loop_tests)
        state.loop_ends = without_last(state.loop_ends)
        if not state.ended:
            backend.ir.emit(state, "br label %" + test_label)
        backend.ir.block_label(state, end_label)
    elif frontend.tokens.accept(state, "return"):
        if frontend.tokens.peek(state) == "<newline>":
            if state.result != "void":
                frontend.diagnostics.fail_at(state, "return requires a value")
            backend.ir.emit(state, "ret void")
        else:
            if state.result == "void":
                frontend.diagnostics.fail_at(state, "a void function cannot return a value")
            returned: frontend.model.Value = backend.literals.coerce(state, frontend.expressions.expression(state, 0, state.result), state.result)
            backend.ir.emit(state, "ret " + backend.ir.typed(state, returned))
        state.ended = true
        frontend.tokens.expect(state, "<newline>")
    elif frontend.tokens.peek(state) == "break" or frontend.tokens.peek(state) == "continue":
        keyword: str = frontend.tokens.take(state)
        if core.len(state.loop_tests) == 0:
            frontend.diagnostics.fail_at(state, keyword + " requires a loop")
        target: str = state.loop_ends[core.len(state.loop_ends) - 1]
        if keyword == "continue":
            target = state.loop_tests[core.len(state.loop_tests) - 1]
        backend.ir.emit(state, "br label %" + target)
        state.ended = true
        frontend.tokens.expect(state, "<newline>")
    elif frontend.tokens.accept(state, "pass"):
        frontend.tokens.expect(state, "<newline>")
    elif state.tokens.kind[state.tokens.position] == 1 and state.tokens.text[state.tokens.position + 1] == ":":
        name: str = frontend.tokens.identifier(state)
        frontend.tokens.expect(state, ":")
        local_type: str = frontend.declarations.parse_type(state)
        frontend.tokens.expect(state, "=")
        initializer: frontend.model.Value = frontend.expressions.expression(state, 0, local_type)
        backend.locals.declare_local(state, name, local_type, initializer)
        frontend.tokens.expect(state, "<newline>")
    else:
        start: int64 = state.tokens.position
        left: frontend.model.Value = frontend.expressions.expression(state, 0, "")
        if frontend.tokens.accept(state, "="):
            if left.pointer == "" or state.tokens.text[start] == "self" and state.tokens.position == start + 2:
                frontend.diagnostics.fail_at(state, "assignment requires mutable storage")
            right: frontend.model.Value = backend.literals.coerce(state, frontend.expressions.expression(state, 0, left.typ), left.typ)
            backend.ir.emit(state, "store " + backend.ir.typed(state, right) + ", ptr " + left.pointer)
        elif state.tokens.text[state.tokens.position - 1] != ")":
            frontend.diagnostics.fail_at(state, "only calls can be expression statements")
        frontend.tokens.expect(state, "<newline>")
