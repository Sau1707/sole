import core
import backend.types
import frontend.builtins
import frontend.diagnostics
import frontend.model
import frontend.symbols
import frontend.sumtypes
import frontend.types


# Check declaration names, field types, signatures, and record layouts.
def validate(state: frontend.model.State) -> void:
    frontend.sumtypes.validate(state)
    # Check record names, field types, and conflicting members.
    i: int64 = 0
    while i < core.len(state.records):
        record: frontend.model.RecordInfo = state.records[i]
        if frontend.symbols.record_index(state, record.name) != i || frontend.builtins.reserved_type_name(record.name):
            frontend.diagnostics.fail_at(state, "duplicate or reserved type: " + record.name)
        j: int64 = 0
        while j < core.len(record.names):
            if record.types[j] == "void" || frontend.types.element_type(record.types[j]) == "void":
                frontend.diagnostics.fail_at(state, "void cannot be a field type")
            backend.types.llvm_type(state, record.types[j])
            if frontend.symbols.function_index(state, record.name + "." + record.names[j]) >= 0:
                frontend.diagnostics.fail_at(state, "duplicate member: " + record.names[j])
            k: int64 = 0
            while k < j:
                if record.names[j] == record.names[k]:
                    frontend.diagnostics.fail_at(state, "duplicate field: " + record.names[j])
                k = k + 1
            j = j + 1
        i = i + 1
    # Walk inline record fields to reject infinite-sized value layouts.
    layout_index: int64 = 0
    while layout_index < core.len(state.records):
        frontend.sumtypes.check_layout(state, state.records[layout_index].name, [])
        layout_index = layout_index + 1
    sum_layout: int64 = 0
    while sum_layout < core.len(state.sums):
        frontend.sumtypes.check_layout(state, state.sums[sum_layout].name, [])
        sum_layout = sum_layout + 1
    # Validate function names, return types, parameters, and foreign signatures.
    f: int64 = 0
    while f < core.len(state.functions):
        fn: frontend.model.FunctionInfo = state.functions[f]
        if frontend.symbols.function_index(state, fn.name) != f || not fn.external && frontend.builtins.reserved_name(fn.name) || frontend.symbols.record_index(state, fn.name) >= 0:
            frontend.diagnostics.fail_at(state, "duplicate or reserved function: " + fn.name)
        backend.types.llvm_type(state, fn.result)
        if fn.external && fn.result != "void" && fn.result != "ptr" && fn.result != "bool" && not frontend.types.integer_type(fn.result) && not frontend.types.float_type(fn.result):
            frontend.diagnostics.fail_at(state, "extern results must be scalar, ptr, or void")
        p: int64 = 0
        while p < core.len(fn.types):
            if fn.types[p] == "void" || frontend.types.element_type(fn.types[p]) == "void":
                frontend.diagnostics.fail_at(state, "void cannot be a parameter type")
            backend.types.llvm_type(state, fn.types[p])
            q: int64 = 0
            while q < p:
                if fn.names[p] == fn.names[q]:
                    frontend.diagnostics.fail_at(state, "duplicate parameter")
                q = q + 1
            if fn.external && not frontend.types.integer_type(fn.types[p]) && not frontend.types.float_type(fn.types[p]) && fn.types[p] != "ptr" && fn.types[p] != "bool":
                frontend.diagnostics.fail_at(state, "extern parameters must be scalar or ptr")
            p = p + 1
        f = f + 1
