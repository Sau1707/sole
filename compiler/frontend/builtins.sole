import core
import frontend.types


# Recognize the compiler-supported intrinsic names.
def builtin_name(name: str) -> bool:
    return name == "print" || name == "len" || name == "append" || name == "join" || name == "slice" || name == "cstr" || name == "from_cstr" || name == "address" || name == "arg_count" || name == "arg" || name == "read_file" || name == "write_file" || name == "exit"


# Protect builtin types and runtime symbols from conflicting declarations.
def reserved_name(name: str) -> bool:
    if core.len(name) >= 5 && core.slice(name, 0, 5) == "_sole":
        return true
    return frontend.types.builtin_type(name) || name == "malloc" || name == "printf" || name == "putchar"


def reserved_type_name(name: str) -> bool:
    return reserved_name(name) || name == "integer" || name == "real"
