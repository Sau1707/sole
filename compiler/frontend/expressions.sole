import core
import backend.casts
import backend.ir
import backend.literals
import backend.operators
import backend.output
import backend.types
import frontend.builtins
import frontend.diagnostics
import frontend.model
import frontend.operators
import frontend.symbols
import frontend.tokens
import frontend.types


# Parse positional arguments using the expected parameter types.
def parse_arguments(state: frontend.model.State, types: str[]) -> frontend.model.Value[]:
    values: frontend.model.Value[] = []
    frontend.tokens.expect(state, "(")
    while frontend.tokens.peek(state) != ")":
        expected: str = ""
        if core.len(values) < core.len(types):
            expected = types[core.len(values)]
        item: frontend.model.Value = expression(state, 0, expected)
        core.append(values, backend.literals.coerce(state, item, expected))
        if not frontend.tokens.accept(state, ","):
            break
    frontend.tokens.expect(state, ")")
    return values


# Validate intrinsic arguments and emit their runtime operations.
def call_builtin(state: frontend.model.State, name: str) -> frontend.model.Value:
    # Infer an appended value's type from the destination array.
    if name == "append":
        frontend.tokens.expect(state, "(")
        array_value: frontend.model.Value = expression(state, 0, "")
        if not frontend.types.dynamic_type(array_value.typ):
            frontend.diagnostics.fail_at(state, "append requires a growable array")
        frontend.tokens.expect(state, ",")
        element: str = frontend.types.element_type(array_value.typ)
        next_item: frontend.model.Value = backend.literals.coerce(state, expression(state, 0, element), element)
        frontend.tokens.expect(state, ")")
        backend.ir.append_ir(state, array_value, next_item)
        return frontend.model.Value("void", "", "")
    # Check ordinary intrinsic argument types and counts.
    types: str[] = []
    if name == "arg" || name == "exit":
        if name == "arg":
            core.append(types, "int64")
        else:
            core.append(types, "int32")
    elif name == "slice":
        types = ["str", "int64", "int64"]
    elif name == "read_file" || name == "cstr":
        types = ["str"]
    elif name == "write_file":
        types = ["str", "str"]
    elif name == "from_cstr":
        types = ["ptr"]
    values: frontend.model.Value[] = parse_arguments(state, types)
    expected_count: int64 = 1
    if name == "arg_count":
        expected_count = 0
    elif name == "write_file":
        expected_count = 2
    elif name == "slice":
        expected_count = 3
    if core.len(values) != expected_count:
        frontend.diagnostics.fail_at(state, name + " expects " + str(expected_count) + " arguments")
    if name == "arg_count":
        return frontend.model.Value("int64", backend.ir.instruction(state, "call i64 @sole_rt_arg_count()"), "")
    value: frontend.model.Value = values[0]
    if name == "print":
        backend.output.print_ir(state, value)
        return frontend.model.Value("void", "", "")
    if name == "len":
        if value.typ == "str":
            return frontend.model.Value("int64", backend.ir.extract(state, value, 1), "")
        if frontend.types.dynamic_type(value.typ):
            return frontend.model.Value("int64", backend.ir.array_length(state, value), "")
        if frontend.types.array_type(value.typ):
            return frontend.model.Value("int64", str(frontend.types.fixed_length(value.typ)), "")
        frontend.diagnostics.fail_at(state, "len requires a string or array")
    elif name == "join":
        if value.typ != "str[]":
            frontend.diagnostics.fail_at(state, "join requires str[]")
        return frontend.model.Value("str", backend.ir.instruction(state, "call {ptr, i64} @_sole.join(ptr " + value.value + ")"), "")
    elif name == "address":
        if value.pointer == "":
            frontend.diagnostics.fail_at(state, "address requires a variable or field")
        return frontend.model.Value("ptr", value.pointer, "")
    elif name == "cstr":
        data: str = backend.ir.extract(state, value, 0)
        length: str = backend.ir.extract(state, value, 1)
        return frontend.model.Value("ptr", backend.ir.instruction(state, "call ptr @_sole.cstr(ptr " + data + ", i64 " + length + ")"), "")
    elif name == "from_cstr":
        backend.ir.checked(state, backend.ir.instruction(state, "icmp ne ptr " + value.value + ", null"))
        count: str = backend.ir.instruction(state, "call i64 @_sole.cstrlen(ptr " + value.value + ")")
        return backend.ir.make_string(state, value.value, count)
    elif name == "slice":
        data_slice: str = backend.ir.extract(state, value, 0)
        total: str = backend.ir.extract(state, value, 1)
        start: str = values[1].value
        stop: str = values[2].value
        ordered: str = backend.ir.instruction(state, "icmp ule i64 " + start + ", " + stop)
        bounded: str = backend.ir.instruction(state, "icmp ule i64 " + stop + ", " + total)
        backend.ir.checked(state, backend.ir.instruction(state, "and i1 " + ordered + ", " + bounded))
        begin: str = backend.ir.instruction(state, "getelementptr i8, ptr " + data_slice + ", i64 " + start)
        count_slice: str = backend.ir.instruction(state, "sub i64 " + stop + ", " + start)
        return backend.ir.make_string(state, begin, count_slice)
    if name == "arg":
        argument: str = backend.ir.instruction(state, "call ptr @sole_rt_arg(i64 " + value.value + ")")
        arg_len: str = backend.ir.instruction(state, "call i64 @_sole.cstrlen(ptr " + argument + ")")
        return backend.ir.make_string(state, argument, arg_len)
    elif name == "exit":
        backend.ir.emit(state, "call void @exit(i32 " + value.value + ")")
        return frontend.model.Value("void", "", "")
    # Convert file paths to C strings before calling native I/O helpers.
    path_data: str = backend.ir.extract(state, value, 0)
    path_length: str = backend.ir.extract(state, value, 1)
    path: str = backend.ir.instruction(state, "call ptr @_sole.cstr(ptr " + path_data + ", i64 " + path_length + ")")
    if name == "read_file":
        out_size: str = backend.ir.slot(state, "int64")
        contents: str = backend.ir.instruction(state, "call ptr @sole_rt_read_file(ptr " + path + ", ptr " + out_size + ")")
        file_size: str = backend.ir.instruction(state, "load i64, ptr " + out_size)
        return backend.ir.make_string(state, contents, file_size)
    if name == "write_file":
        content_data: str = backend.ir.extract(state, values[1], 0)
        content_size: str = backend.ir.extract(state, values[1], 1)
        backend.ir.emit(state, "call void @sole_rt_write_file(ptr " + path + ", ptr " + content_data + ", i64 " + content_size + ")")
        return frontend.model.Value("void", "", "")
    frontend.diagnostics.fail_at(state, "unknown builtin " + name)
    return frontend.model.Value("void", "", "")


# Resolve intrinsic calls, casts, constructors, functions, and methods.
def named_call(state: frontend.model.State, name: str, receiver: frontend.model.Value[]) -> frontend.model.Value:
    if core.len(receiver) == 0 && core.len(name) > 17 && core.slice(name, 0, 17) == "__sole_intrinsic_":
        return call_builtin(state, core.slice(name, 17, core.len(name)))
    if core.len(receiver) == 0 && (frontend.types.integer_type(name) || frontend.types.float_type(name) || name == "bool" || name == "ptr" || name == "str"):
        frontend.tokens.expect(state, "(")
        argument: frontend.model.Value = expression(state, 0, name)
        frontend.tokens.expect(state, ")")
        if name == "str":
            argument = backend.literals.coerce(state, argument, "")
            if not frontend.types.integer_type(argument.typ):
                frontend.diagnostics.fail_at(state, "str conversion requires an integer")
            wide: frontend.model.Value = backend.casts.cast_value(state, argument, "int64")
            negative: str = "false"
            if not frontend.types.unsigned_type(argument.typ):
                negative = backend.ir.instruction(state, "icmp slt i64 " + wide.value + ", 0")
            return frontend.model.Value("str", backend.ir.instruction(state, "call {ptr, i64} @_sole.number_str(i64 " + wide.value + ", i1 " + negative + ")"), "")
        return backend.casts.cast_value(state, argument, name)
    ri: int64 = frontend.symbols.record_index(state, name)
    if core.len(receiver) == 0 && ri >= 0:
        record: frontend.model.RecordInfo = state.records[ri]
        arguments: frontend.model.Value[] = parse_arguments(state, record.types)
        if core.len(arguments) != core.len(record.types):
            frontend.diagnostics.fail_at(state, "wrong number of constructor fields for " + name)
        aggregate: str = "poison"
        pointer: str = ""
        if record.kind == "class":
            end: str = backend.ir.instruction(state, "getelementptr %" + name + ", ptr null, i32 1")
            size: str = backend.ir.instruction(state, "ptrtoint ptr " + end + " to i64")
            pointer = backend.ir.instruction(state, "call ptr @_sole.alloc64(i64 " + size + ")")
        i: int64 = 0
        while i < core.len(arguments):
            if record.kind == "class":
                field: str = backend.ir.instruction(state, "getelementptr %" + name + ", ptr " + pointer + ", i32 0, i32 " + str(i))
                backend.ir.emit(state, "store " + backend.ir.typed(state, arguments[i]) + ", ptr " + field)
            else:
                aggregate = backend.ir.instruction(state, "insertvalue %" + name + " " + aggregate + ", " + backend.ir.typed(state, arguments[i]) + ", " + str(i))
            i = i + 1
        if record.kind == "class":
            return frontend.model.Value(name, pointer, "")
        if core.len(arguments) == 0:
            aggregate = "zeroinitializer"
        return frontend.model.Value(name, aggregate, "")
    fi: int64 = frontend.symbols.function_index(state, name)
    if fi < 0:
        frontend.diagnostics.fail_at(state, "unknown function '" + name + "'")
    fn: frontend.model.FunctionInfo = state.functions[fi]
    parameter_types: str[] = fn.types
    if core.len(receiver) > 0:
        parameter_types = []
        j: int64 = core.len(receiver)
        while j < core.len(fn.types):
            core.append(parameter_types, fn.types[j])
            j = j + 1
    values: frontend.model.Value[] = parse_arguments(state, parameter_types)
    if core.len(values) + core.len(receiver) != core.len(fn.types):
        frontend.diagnostics.fail_at(state, "wrong number of arguments for " + name)
    parts: str[] = []
    if core.len(receiver) > 0:
        core.append(parts, backend.ir.typed(state, receiver[0]))
    k: int64 = 0
    while k < core.len(values):
        if core.len(parts) > 0:
            core.append(parts, ", ")
        core.append(parts, backend.ir.typed(state, values[k]))
        k = k + 1
    call_text: str = "call " + backend.types.llvm_type(state, fn.result) + " @" + backend.ir.function_symbol(fn) + "(" + core.join(parts) + ")"
    if fn.result == "void":
        backend.ir.emit(state, call_text)
        return frontend.model.Value("void", "", "")
    return frontend.model.Value(fn.result, backend.ir.instruction(state, call_text), "")


def expression(state: frontend.model.State, minimum: int32, expected: str) -> frontend.model.Value:
    return parse_expression(state, minimum, expected).value


# Parse and lower an expression using operator precedence.
def parse_expression(state: frontend.model.State, minimum: int32, expected: str) -> frontend.model.Expression:
    # Read the initial literal, unary operation, grouped value, or name.
    kind: int32 = state.tokens.kind[state.tokens.position]
    text: str = frontend.tokens.take(state)
    left: frontend.model.Value = frontend.model.Value("void", "", "")
    is_call: bool = false
    if kind == 3:
        left = backend.literals.string_constant(state, text)
    elif text == "-" || text == "~" || text == "not":
        direct_number: bool = state.tokens.kind[state.tokens.position] == 2
        level: int32 = 10
        if text == "not":
            level = 3
        operand: frontend.model.Value = expression(state, level, expected)
        if text == "-" && operand.typ == "integer" && direct_number:
            left = frontend.model.Value("integer", "-" + operand.value, "")
        else:
            operand_context: str = ""
            if frontend.types.integer_type(expected) || frontend.types.float_type(expected):
                operand_context = expected
            operand = backend.literals.coerce(state, operand, operand_context)
            if text == "not":
                operand = backend.literals.coerce(state, operand, "bool")
                left = frontend.model.Value("bool", backend.ir.instruction(state, "xor i1 " + operand.value + ", true"), "")
            elif text == "~" && frontend.types.integer_type(operand.typ):
                left = frontend.model.Value(operand.typ, backend.ir.instruction(state, "xor " + backend.ir.typed(state, operand) + ", -1"), "")
            elif text == "-" && frontend.types.float_type(operand.typ):
                left = frontend.model.Value(operand.typ, backend.ir.instruction(state, "fneg " + backend.ir.typed(state, operand)), "")
            elif text == "-" && frontend.types.integer_type(operand.typ):
                left = frontend.model.Value(operand.typ, backend.ir.instruction(state, "sub " + backend.types.llvm_type(state, operand.typ) + " 0, " + operand.value), "")
            else:
                frontend.diagnostics.fail_at(state, "invalid unary operator")
    elif text == "(":
        grouped: frontend.model.Expression = parse_expression(state, 0, expected)
        left = grouped.value
        is_call = grouped.is_call
        frontend.tokens.expect(state, ")")
    elif text == "[":
        if not frontend.types.array_type(expected):
            frontend.diagnostics.fail_at(state, "array literals need an array type")
        element: str = frontend.types.element_type(expected)
        left = frontend.model.Value(expected, "poison", "")
        if frontend.types.dynamic_type(expected):
            left.value = backend.ir.instruction(state, "call ptr @_sole.array_new()")
        count: int64 = 0
        while frontend.tokens.peek(state) != "]":
            item: frontend.model.Value = backend.literals.coerce(state, expression(state, 0, element), element)
            if frontend.types.dynamic_type(expected):
                backend.ir.append_ir(state, left, item)
            else:
                if count >= frontend.types.fixed_length(expected):
                    frontend.diagnostics.fail_at(state, "too many array elements")
                left.value = backend.ir.instruction(state, "insertvalue " + backend.types.llvm_type(state, expected) + " " + left.value + ", " + backend.ir.typed(state, item) + ", " + str(count))
            count = count + 1
            if not frontend.tokens.accept(state, ","):
                break
        frontend.tokens.expect(state, "]")
        if not frontend.types.dynamic_type(expected) && count != frontend.types.fixed_length(expected):
            frontend.diagnostics.fail_at(state, "wrong number of array elements")
    elif text == "true" || text == "false":
        left = frontend.model.Value("bool", text, "")
    elif kind == 2:
        number_kind: str = "integer"
        hex_number: bool = core.len(text) > 1 && text[0] == 48 && (text[1] == 120 || text[1] == 88)
        n: int64 = 0
        while n < core.len(text):
            if text[n] == 46 || not hex_number && (text[n] == 101 || text[n] == 69):
                number_kind = "real"
            n = n + 1
        left = frontend.model.Value(number_kind, text, "")
    elif kind == 1:
        if frontend.tokens.peek(state) == "(":
            left = named_call(state, text, [])
            is_call = true
        else:
            li: int64 = frontend.symbols.local_index(state, text)
            if li < 0:
                frontend.diagnostics.fail_at(state, "unknown variable '" + text + "'")
            variable_type: str = state.types[li]
            variable_pointer: str = state.pointers[li]
            loaded: str = backend.ir.instruction(state, "load " + backend.types.llvm_type(state, variable_type) + ", ptr " + variable_pointer)
            left = frontend.model.Value(variable_type, loaded, variable_pointer)
    else:
        frontend.diagnostics.fail_at(state, "expected an expression, got '" + text + "'")
    while true:
        # Extend the value with members, indexes, or binary operators.
        if frontend.tokens.accept(state, "."):
            member: str = frontend.tokens.identifier(state)
            if frontend.tokens.peek(state) == "(":
                receivers: frontend.model.Value[] = [left]
                left = named_call(state, left.typ + "." + member, receivers)
                is_call = true
            else:
                is_call = false
                record_id: int64 = frontend.symbols.record_index(state, left.typ)
                if record_id < 0:
                    frontend.diagnostics.fail_at(state, "this value has no fields")
                info: frontend.model.RecordInfo = state.records[record_id]
                field_index: int64 = 0
                while field_index < core.len(info.names) && info.names[field_index] != member:
                    field_index = field_index + 1
                if field_index == core.len(info.names):
                    frontend.diagnostics.fail_at(state, "unknown field '" + member + "'")
                field_type: str = info.types[field_index]
                base_pointer: str = left.pointer
                if info.kind == "class":
                    base_pointer = left.value
                if base_pointer != "":
                    field_pointer: str = backend.ir.instruction(state, "getelementptr %" + info.name + ", ptr " + base_pointer + ", i32 0, i32 " + str(field_index))
                    field_value: str = backend.ir.instruction(state, "load " + backend.types.llvm_type(state, field_type) + ", ptr " + field_pointer)
                    left = frontend.model.Value(field_type, field_value, field_pointer)
                else:
                    left = frontend.model.Value(field_type, backend.ir.extract(state, left, field_index), "")
        elif frontend.tokens.accept(state, "["):
            is_call = false
            index_value: frontend.model.Value = backend.literals.coerce(state, expression(state, 0, ""), "")
            if not frontend.types.integer_type(index_value.typ):
                frontend.diagnostics.fail_at(state, "an index must be an integer")
            wide_index: frontend.model.Value = backend.casts.cast_value(state, index_value, "int64")
            frontend.tokens.expect(state, "]")
            length: str = ""
            data: str = ""
            elem: str = ""
            if left.typ == "str":
                length = backend.ir.extract(state, left, 1)
                data = backend.ir.extract(state, left, 0)
                elem = "uint8"
            elif frontend.types.dynamic_type(left.typ):
                length = backend.ir.array_length(state, left)
                data = backend.ir.instruction(state, "load ptr, ptr " + left.value)
                elem = frontend.types.element_type(left.typ)
            elif frontend.types.array_type(left.typ):
                length = str(frontend.types.fixed_length(left.typ))
                elem = frontend.types.element_type(left.typ)
                data = left.pointer
                if data == "":
                    data = backend.ir.slot(state, left.typ)
                    backend.ir.emit(state, "store " + backend.ir.typed(state, left) + ", ptr " + data)
                data = backend.ir.instruction(state, "getelementptr " + backend.types.llvm_type(state, left.typ) + ", ptr " + data + ", i32 0, i32 0")
            else:
                frontend.diagnostics.fail_at(state, "only arrays and strings can be indexed")
            backend.ir.checked(state, backend.ir.instruction(state, "icmp ult i64 " + wide_index.value + ", " + length))
            item_pointer: str = backend.ir.instruction(state, "getelementptr " + backend.types.llvm_type(state, elem) + ", ptr " + data + ", i64 " + wide_index.value)
            item_value: str = backend.ir.instruction(state, "load " + backend.types.llvm_type(state, elem) + ", ptr " + item_pointer)
            address_value: str = item_pointer
            if left.typ == "str":
                address_value = ""
            left = frontend.model.Value(elem, item_value, address_value)
        else:
            operator: str = frontend.tokens.peek(state)
            power: int32 = frontend.operators.precedence(operator)
            if power < minimum:
                break
            is_call = false
            frontend.tokens.take(state)
            if operator == "&&" || operator == "||":
                left = backend.literals.coerce(state, left, "bool")
                rhs_label: str = backend.ir.fresh(state)
                short_label: str = backend.ir.fresh(state)
                end_label: str = backend.ir.fresh(state)
                bool_slot: str = backend.ir.slot(state, "bool")
                if operator == "&&":
                    backend.ir.emit(state, "br i1 " + left.value + ", label %" + rhs_label + ", label %" + short_label)
                else:
                    backend.ir.emit(state, "br i1 " + left.value + ", label %" + short_label + ", label %" + rhs_label)
                backend.ir.block_label(state, short_label)
                backend.ir.emit(state, "store i1 " + left.value + ", ptr " + bool_slot)
                backend.ir.emit(state, "br label %" + end_label)
                backend.ir.block_label(state, rhs_label)
                rhs_bool: frontend.model.Value = backend.literals.coerce(state, expression(state, power + 1, "bool"), "bool")
                backend.ir.emit(state, "store i1 " + rhs_bool.value + ", ptr " + bool_slot)
                backend.ir.emit(state, "br label %" + end_label)
                backend.ir.block_label(state, end_label)
                left = frontend.model.Value("bool", backend.ir.instruction(state, "load i1, ptr " + bool_slot), "")
            else:
                right: frontend.model.Value = expression(state, power + 1, expected)
                left = backend.operators.binary_ir(state, operator, left, right, expected)
                if power == 3 && frontend.operators.precedence(frontend.tokens.peek(state)) == 3:
                    frontend.diagnostics.fail_at(state, "chained comparisons are not supported")
    return frontend.model.Expression(left, is_call)
