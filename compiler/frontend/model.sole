# Store token text, kinds, source locations, and the parser cursor.
class Tokens:
    text: str[]
    kind: int32[]
    line: int64[]
    position: int64
    files: str[]


# Track a module's declarations, imports, and loading state.
class ModuleInfo:
    path: str
    prefix: str
    tokens: Tokens
    names: str[]
    aliases: str[]
    dependencies: int64[]
    removed: bool[]
    active: bool
    intrinsics: str[]


# Describe the fields and kind of a struct or class.
class RecordInfo:
    name: str
    kind: str
    names: str[]
    types: str[]


# Describe a function's signature and body location.
class FunctionInfo:
    name: str
    names: str[]
    types: str[]
    result: str
    body: int64
    external: bool


# Share declarations, local scopes, and emitted IR during compilation.
class State:
    tokens: Tokens
    records: RecordInfo[]
    functions: FunctionInfo[]
    globals: str[]
    definitions: str[]
    code: str[]
    slots: str[]
    names: str[]
    types: str[]
    pointers: str[]
    depths: int32[]
    loop_tests: str[]
    loop_ends: str[]
    serial: int64
    depth: int32
    ended: bool
    result: str
    filename: str


# Carry an expression's type, LLVM value, and optional storage address.
class Value:
    typ: str
    value: str
    pointer: str


struct Expression:
    value: Value
    is_call: bool
