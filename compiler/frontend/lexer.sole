import core
import frontend.characters
import frontend.diagnostics
import frontend.model
import frontend.tokens


# Convert source text into tokens while tracking indentation and lines.
def lex(text: str) -> frontend.model.Tokens:
    tokens: frontend.model.Tokens = frontend.model.Tokens([], [], [], 0, [])
    levels: int64[] = [0]
    i: int64 = 0
    line: int64 = 1
    beginning: bool = true
    nesting: int32 = 0
    while i < core.len(text):
        if beginning and nesting != 0:
            beginning = false
        # Emit indentation changes only outside continued expressions.
        if beginning and nesting == 0:
            indent_width: int64 = 0
            while i < core.len(text) and text[i] == 32:
                indent_width = indent_width + 1
                i = i + 1
            if i < core.len(text) and text[i] == 9:
                frontend.diagnostics.die("tabs are not allowed at line " + str(line))
            if i == core.len(text):
                break
            if text[i] != 10 and text[i] != 13 and text[i] != 35:
                top: int64 = core.len(levels) - 1
                if indent_width > levels[top]:
                    core.append(levels, indent_width)
                    frontend.tokens.token_add(tokens, "<indent>", 5, line)
                else:
                    while top > 0 and indent_width < levels[top]:
                        levels[top] = -1
                        top = top - 1
                        frontend.tokens.token_add(tokens, "<dedent>", 6, line)
                    if indent_width != levels[top]:
                        frontend.diagnostics.die("inconsistent indentation at line " + str(line))
                    trimmed: int64[] = []
                    j: int64 = 0
                    while j <= top:
                        core.append(trimmed, levels[j])
                        j = j + 1
                    levels = trimmed
            beginning = false
        # Separate whitespace, comments, literals, and punctuation.
        byte: uint8 = text[i]
        if byte == 32 or byte == 13:
            i = i + 1
        elif byte == 9:
            frontend.diagnostics.die("tabs are not allowed at line " + str(line))
        elif byte == 35:
            while i < core.len(text) and text[i] != 10:
                i = i + 1
        elif byte == 10:
            if nesting == 0 and core.len(tokens.kind) > 0:
                last: int32 = tokens.kind[core.len(tokens.kind) - 1]
                if last != 4 and last != 5 and last != 6:
                    frontend.tokens.token_add(tokens, "<newline>", 4, line)
            i = i + 1
            line = line + 1
            beginning = true
        elif frontend.characters.letter(byte):
            start: int64 = i
            i = i + 1
            while i < core.len(text) and (frontend.characters.letter(text[i]) or frontend.characters.digit(text[i])):
                i = i + 1
            frontend.tokens.token_add(tokens, core.slice(text, start, i), 1, line)
        elif frontend.characters.digit(byte):
            start_number: int64 = i
            hex_number: bool = i + 1 < core.len(text) and text[i] == 48 and (text[i + 1] == 120 or text[i + 1] == 88)
            i = i + 1
            while i < core.len(text) and (frontend.characters.letter(text[i]) or frontend.characters.digit(text[i]) or text[i] == 46):
                i = i + 1
                if not hex_number and i < core.len(text) and (text[i - 1] == 101 or text[i - 1] == 69) and (text[i] == 43 or text[i] == 45):
                    i = i + 1
            frontend.tokens.token_add(tokens, core.slice(text, start_number, i), 2, line)
        elif byte == 34 or byte == 39:
            quote: uint8 = byte
            start_line: int64 = line
            triple: bool = i + 2 < core.len(text) and text[i + 1] == quote and text[i + 2] == quote
            width: int64 = 1
            if triple:
                width = 3
            i = i + width
            parts: str[] = []
            closed: bool = false
            while i < core.len(text):
                if text[i] == quote and (not triple or i + 2 < core.len(text) and text[i + 1] == quote and text[i + 2] == quote):
                    closed = true
                    break
                if text[i] == 10:
                    if not triple:
                        frontend.diagnostics.die("unterminated string at line " + str(start_line))
                    line = line + 1
                if text[i] == 92:
                    i = i + 1
                    if i == core.len(text):
                        frontend.diagnostics.die("unterminated string")
                    escaped: uint8 = text[i]
                    if escaped == 110:
                        core.append(parts, "\n")
                    elif escaped == 114:
                        core.append(parts, "\r")
                    elif escaped == 116:
                        core.append(parts, "\t")
                    elif escaped == 48:
                        core.append(parts, "\0")
                    elif escaped == 92 or escaped == 34 or escaped == 39:
                        core.append(parts, core.slice(text, i, i + 1))
                    else:
                        frontend.diagnostics.die("unsupported string escape at line " + str(line))
                else:
                    core.append(parts, core.slice(text, i, i + 1))
                i = i + 1
            if not closed:
                frontend.diagnostics.die("unterminated string at line " + str(start_line))
            i = i + width
            frontend.tokens.token_add(tokens, core.join(parts), 3, start_line)
        else:
            punct: str = core.slice(text, i, i + 1)
            if i + 1 < core.len(text):
                pair: str = core.slice(text, i, i + 2)
                if pair == "->" or pair == "==" or pair == "!=" or pair == "<=" or pair == ">=" or pair == "<<" or pair == ">>":
                    punct = pair
            if punct == "(" or punct == "[":
                nesting = nesting + 1
            elif punct == ")" or punct == "]":
                nesting = nesting - 1
                if nesting < 0:
                    frontend.diagnostics.die("unmatched closing delimiter")
            frontend.tokens.token_add(tokens, punct, 7, line)
            i = i + core.len(punct)
    # Close the final line and indentation levels before ending the stream.
    if nesting != 0:
        frontend.diagnostics.die("unclosed delimiter")
    if core.len(tokens.kind) > 0 and tokens.kind[core.len(tokens.kind) - 1] != 4 and tokens.kind[core.len(tokens.kind) - 1] != 6:
        frontend.tokens.token_add(tokens, "<newline>", 4, line)
    k: int64 = core.len(levels) - 1
    while k > 0:
        frontend.tokens.token_add(tokens, "<dedent>", 6, line)
        k = k - 1
    frontend.tokens.token_add(tokens, "<end>", 0, line)
    return tokens
