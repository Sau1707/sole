import core
import frontend.diagnostics
import frontend.builtins
import frontend.lexer as lexer
import frontend.model
import frontend.tokens
import wrappers.system


# Return a file's containing directory with a trailing separator.
def parent_directory(path: str) -> str:
    i: int64 = core.len(path) - 1
    while i >= 0:
        if path[i] == 47:
            return core.slice(path, 0, i + 1)
        i = i - 1
    return "./"


# Translate a dotted module name into a relative Sole filename.
def module_path(name: str) -> str:
    parts: str[] = []
    i: int64 = 0
    while i < core.len(name):
        if name[i] == 46:
            core.append(parts, "/")
        else:
            core.append(parts, core.slice(name, i, i + 1))
        i = i + 1
    return core.join(parts) + ".sole"


# Find a module in local, project, or standard-library directories.
def resolve_import(module: frontend.model.ModuleInfo, name: str, position: int64, entry_directory: str) -> str:
    relative: str = module_path(name)
    library: str = core.from_cstr(wrappers.system.sole_rt_lib_home())
    candidates: str[] = [parent_directory(module.path) + relative, entry_directory + relative, library + "/" + relative, library + "/pure/" + relative, library + "/impure/" + relative, library + "/wrappers/" + relative]
    i: int64 = 0
    while i < core.len(candidates):
        if wrappers.system.sole_rt_is_file(core.cstr(candidates[i])) != 0:
            return core.from_cstr(wrappers.system.sole_rt_realpath(core.cstr(candidates[i])))
        i = i + 1
    frontend.diagnostics.module_error(module, position, "cannot find module '" + name + "'")
    return ""


# Load a module's declarations and dependencies, rejecting import cycles.
def load_module(modules: frontend.model.ModuleInfo[], path: str, source: str) -> int64:
    # Reuse completed modules and reject dependencies still being loaded.
    existing: int64 = 0
    while existing < core.len(modules):
        if modules[existing].path == path:
            if modules[existing].active:
                frontend.diagnostics.die("circular import involving '" + path + "'")
            return existing
        existing = existing + 1
    index: int64 = core.len(modules)
    prefix: str = ""
    if index > 0:
        prefix = "__sole_m" + str(index) + "__"
    tokens: frontend.model.Tokens = lexer.lex(source)
    removed: bool[] = []
    n: int64 = 0
    while n < core.len(tokens.kind):
        core.append(removed, false)
        n = n + 1
    module: frontend.model.ModuleInfo = frontend.model.ModuleInfo(path, prefix, tokens, [], [], [], removed, true, [])
    core.append(modules, module)
    if core.len(tokens.kind) > 1 && tokens.kind[0] == 3 && tokens.kind[1] == 4:
        module.removed[0] = true
        module.removed[1] = true
    # Collect declarations, intrinsic exports, and import aliases.
    positions: int64[] = []
    imports: str[] = []
    depth: int32 = 0
    i: int64 = 0
    while i < core.len(tokens.kind):
        kind: int32 = tokens.kind[i]
        text: str = tokens.text[i]
        if kind == 1 && core.len(text) >= 7 && core.slice(text, 0, 7) == "__sole_":
            frontend.diagnostics.module_error(module, i, "names beginning with '__sole_' are reserved")
        if kind == 5:
            depth = depth + 1
        elif kind == 6:
            depth = depth - 1
        if depth == 0 && kind == 1 && (text == "def" || text == "struct" || text == "class" || text == "enum" || text == "union"):
            if has_name(module.names, tokens.text[i + 1]):
                frontend.diagnostics.module_error(module, i + 1, "duplicate declaration '" + tokens.text[i + 1] + "'")
            core.append(module.names, tokens.text[i + 1])
        if depth == 0 && kind == 1 && text == "intrinsic":
            name: str = tokens.text[i + 1]
            if not frontend.builtins.builtin_name(name):
                frontend.diagnostics.module_error(module, i + 1, "unknown intrinsic '" + name + "'")
            if has_name(module.names, name):
                frontend.diagnostics.module_error(module, i + 1, "duplicate declaration '" + name + "'")
            if tokens.kind[i + 2] != 4:
                frontend.diagnostics.module_error(module, i + 2, "expected newline after intrinsic")
            core.append(module.names, name)
            core.append(module.intrinsics, name)
            module.removed[i] = true
            module.removed[i + 1] = true
            module.removed[i + 2] = true
            i = i + 2
        if depth == 0 && kind == 1 && text == "import":
            start: int64 = i
            i = i + 1
            alias: str = ""
            while true:
                if tokens.kind[i] != 1 || frontend.tokens.reserved_keyword(tokens.text[i]):
                    frontend.diagnostics.module_error(module, i, "expected a module name")
                alias = alias + tokens.text[i]
                i = i + 1
                if tokens.kind[i] != 7 || tokens.text[i] != ".":
                    break
                alias = alias + "."
                i = i + 1
            name: str = alias
            if tokens.kind[i] == 1 && tokens.text[i] == "as":
                i = i + 1
                if tokens.kind[i] != 1 || frontend.tokens.reserved_keyword(tokens.text[i]):
                    frontend.diagnostics.module_error(module, i, "expected an import alias")
                alias = tokens.text[i]
                if core.len(alias) >= 7 && core.slice(alias, 0, 7) == "__sole_":
                    frontend.diagnostics.module_error(module, i, "names beginning with '__sole_' are reserved")
                i = i + 1
            if tokens.kind[i] != 4:
                frontend.diagnostics.module_error(module, i, "expected newline after import")
            a: int64 = 0
            while a < core.len(module.aliases):
                if module.aliases[a] == alias:
                    frontend.diagnostics.module_error(module, start, "duplicate import '" + alias + "'")
                a = a + 1
            core.append(module.aliases, alias)
            core.append(imports, name)
            core.append(positions, start)
            j: int64 = start
            while j <= i:
                module.removed[j] = true
                j = j + 1
        i = i + 1
    a: int64 = 0
    # Resolve and load each dependency after scanning this module.
    while a < core.len(module.aliases):
        dependency_path: str = resolve_import(module, imports[a], positions[a], parent_directory(modules[0].path))
        dependency: int64 = load_module(modules, dependency_path, core.read_file(dependency_path))
        core.append(module.dependencies, dependency)
        a = a + 1
    module.active = false
    return index


# Extract the first component of a dotted namespace.
def namespace_root(name: str) -> str:
    i: int64 = 0
    while i < core.len(name) && name[i] != 46:
        i = i + 1
    return core.slice(name, 0, i)


# Check whether a declaration or namespace name is already present.
def has_name(names: str[], name: str) -> bool:
    i: int64 = 0
    while i < core.len(names):
        if names[i] == name:
            return true
        i = i + 1
    return false


# Qualify module references and copy tokens with their source locations.
def rewrite_module(modules: frontend.model.ModuleInfo[], index: int64, output: frontend.model.Tokens) -> void:
    module: frontend.model.ModuleInfo = modules[index]
    tokens: frontend.model.Tokens = module.tokens
    roots: str[] = []
    a: int64 = 0
    while a < core.len(module.aliases):
        root: str = namespace_root(module.aliases[a])
        if has_name(module.names, root):
            frontend.diagnostics.module_error(module, 0, "module namespace conflicts with a declaration: " + root)
        core.append(roots, root)
        a = a + 1
    depth: int32 = 0
    record_scope: bool = false
    sum_scope: bool = false
    pattern: bool = false
    pattern_bindings: bool = false
    line_start: bool = true
    i: int64 = 0
    while i < core.len(tokens.kind) - 1:
        if module.removed[i]:
            i = i + 1
            continue
        kind: int32 = tokens.kind[i]
        text: str = tokens.text[i]
        original: str = text
        source_line: int64 = tokens.line[i]
        previous: str = ""
        if i > 0:
            previous = tokens.text[i - 1]
        following: str = tokens.text[i + 1]
        label: bool = sum_scope && depth == 1 && (line_start || following == ":" && (previous == "(" || previous == ","))
        if following == "=" && (previous == "(" || previous == ","):
            label = true
        range_syntax: bool = text == "range" && previous == "in"
        if pattern && text == "(":
            pattern_bindings = true
        if kind == 1 && pattern_bindings && (has_name(module.names, text) || has_name(roots, text)):
            frontend.diagnostics.module_error(module, i, "pattern binding conflicts with a declaration or namespace: " + text)
        if kind == 1 && not label && not pattern_bindings && not range_syntax:
            if has_name(roots, text) && (following == ":" || previous == "def" || previous == "struct" || previous == "class" || previous == "enum" || previous == "union" || previous == "for"):
                frontend.diagnostics.module_error(module, i, "module namespace cannot be rebound: " + text)
            if previous != ".":
                ends: int64[] = [i]
                parts: str[] = [text]
                end: int64 = i
                while end + 2 < core.len(tokens.kind) && tokens.text[end + 1] == "." && tokens.kind[end + 2] == 1:
                    end = end + 2
                    core.append(parts, tokens.text[end])
                    core.append(ends, end)
                matched: int64 = -1
                matched_parts: int64 = 0
                alias_index: int64 = 0
                while alias_index < core.len(module.aliases):
                    alias: str = module.aliases[alias_index]
                    prefix: str = ""
                    p: int64 = 0
                    while p < core.len(parts):
                        if p > 0:
                            prefix = prefix + "."
                        prefix = prefix + parts[p]
                        if prefix == alias && p + 1 > matched_parts:
                            matched = alias_index
                            matched_parts = p + 1
                        p = p + 1
                    alias_index = alias_index + 1
                if matched >= 0:
                    if matched_parts >= core.len(parts):
                        frontend.diagnostics.module_error(module, i, "a module namespace is not a value")
                    dependency: frontend.model.ModuleInfo = modules[module.dependencies[matched]]
                    member: str = parts[matched_parts]
                    if not has_name(dependency.names, member):
                        frontend.diagnostics.module_error(module, i, "module '" + module.aliases[matched] + "' has no declaration '" + member + "'")
                    text = dependency.prefix + member
                    if has_name(dependency.intrinsics, member):
                        text = "__sole_intrinsic_" + member
                    i = ends[matched_parts]
                elif has_name(roots, text):
                    frontend.diagnostics.module_error(module, i, "unknown module member")
                else:
                    field: bool = record_scope && depth == 1 && line_start && following == ":"
                    method: bool = record_scope && depth == 1 && previous == "def"
                    if has_name(module.names, text) && not field && not method:
                        if has_name(module.intrinsics, text):
                            text = "__sole_intrinsic_" + text
                        else:
                            text = module.prefix + text
        if kind == 1 && (original == "class" || original == "struct") && depth == 0:
            record_scope = true
        if kind == 1 && (original == "enum" || original == "union") && depth == 0:
            sum_scope = true
        if kind == 1 && original == "case":
            pattern = true
        if pattern && (original == ":" || kind == 4):
            pattern = false
            pattern_bindings = false
        if kind == 5:
            depth = depth + 1
        elif kind == 6:
            depth = depth - 1
            if depth == 0:
                record_scope = false
                sum_scope = false
        if kind == 4 || kind == 5 || kind == 6:
            line_start = true
        else:
            line_start = false
        frontend.tokens.token_add(output, text, kind, source_line)
        output.files[core.len(output.files) - 1] = module.path
        i = i + 1


# Combine the entry module and its dependencies into one token stream.
def load_imports(filename: str, source: str, inputs: str[]) -> frontend.model.Tokens:
    modules: frontend.model.ModuleInfo[] = []
    path: str = core.from_cstr(wrappers.system.sole_rt_realpath(core.cstr(filename)))
    load_module(modules, path, source)
    output: frontend.model.Tokens = frontend.model.Tokens([], [], [], 0, [])
    i: int64 = 0
    while i < core.len(modules):
        core.append(inputs, modules[i].path)
        rewrite_module(modules, i, output)
        i = i + 1
    frontend.tokens.token_add(output, "<end>", 0, 1)
    output.files[core.len(output.files) - 1] = path
    return output
