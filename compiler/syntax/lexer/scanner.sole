import core
import diagnostics.report as diagnostics
import syntax.lexer.characters as characters
import syntax.lexer.tokens as lexical_tokens


def lex(text: str) -> lexical_tokens.Tokens:
    """Convert source text into tokens while tracking indentation and lines."""
    tokens: lexical_tokens.Tokens = lexical_tokens.Tokens([], [], [], 0, [])
    levels: int64[] = [0]
    i: int64 = 0
    line: int64 = 1
    beginning: bool = true
    nesting: int32 = 0
    while i < core.len(text):
        if beginning && nesting != 0:
            beginning = false

        # Emit indentation changes only outside continued expressions.
        if beginning && nesting == 0:
            indent_width: int64 = 0
            while i < core.len(text) && text[i] == 32:
                indent_width = indent_width + 1
                i = i + 1
            if i < core.len(text) && text[i] == 9:
                diagnostics.die("tabs are not allowed at line " + str(line))
            if i == core.len(text):
                break
            if text[i] != 10 && text[i] != 13 && text[i] != 35:
                top: int64 = core.len(levels) - 1
                if indent_width > levels[top]:
                    core.append(levels, indent_width)
                    tokens.add("<indent>", 5, line)
                else:
                    while top > 0 && indent_width < levels[top]:
                        top = top - 1
                        tokens.add("<dedent>", 6, line)
                    if indent_width != levels[top]:
                        diagnostics.die("inconsistent indentation at line " + str(line))
                    if top < core.len(levels) - 1:
                        trimmed: int64[] = []
                        for j in range(top + 1):
                            core.append(trimmed, levels[j])
                        levels = trimmed
            beginning = false

        # Separate whitespace, comments, literals, and punctuation.
        byte: uint8 = text[i]
        byte_literal: bool = byte == 98 && i + 1 < core.len(text) && (text[i + 1] == 34 || text[i + 1] == 39)
        if byte == 32 || byte == 13:
            i = i + 1
        elif byte == 9:
            diagnostics.die("tabs are not allowed at line " + str(line))
        elif byte == 35:
            while i < core.len(text) && text[i] != 10:
                i = i + 1
        elif byte == 10:
            if nesting == 0 && core.len(tokens.kind) > 0:
                last: int32 = tokens.kind[core.len(tokens.kind) - 1]
                if last != 4 && last != 5 && last != 6:
                    tokens.add("<newline>", 4, line)
            i = i + 1
            line = line + 1
            beginning = true
        elif byte == 194 && i + 1 < core.len(text) && text[i + 1] == 162:
            tokens.add("¢", 7, line)
            i = i + 2
        elif characters.letter(byte) && not byte_literal:
            start: int64 = i
            i = i + 1
            while i < core.len(text) && (characters.letter(text[i]) || characters.digit(text[i])):
                i = i + 1
            tokens.add(core.slice(text, start, i), 1, line)
        elif characters.digit(byte):
            start_number: int64 = i
            hex_number: bool = i + 1 < core.len(text) && text[i] == 48 && (text[i + 1] == 120 || text[i + 1] == 88)
            i = i + 1
            while i < core.len(text) && (characters.letter(text[i]) || characters.digit(text[i]) || text[i] == 46):
                i = i + 1
                if not hex_number && i < core.len(text) && (text[i - 1] == 101 || text[i - 1] == 69) && (text[i] == 43 || text[i] == 45):
                    i = i + 1
            tokens.add(core.slice(text, start_number, i), 2, line)
        elif byte == 34 || byte == 39 || byte_literal:
            literal_kind: int32 = 3
            literal_name: str = "string"
            if byte_literal:
                literal_kind = 8
                literal_name = "byte literal"
                i = i + 1
            quote: uint8 = text[i]
            start_line: int64 = line
            triple: bool = i + 2 < core.len(text) && text[i + 1] == quote && text[i + 2] == quote
            if literal_kind == 8 && triple:
                diagnostics.die("byte literals cannot be triple-quoted at line " + str(line))
            width: int64 = 1
            if triple:
                width = 3
            i = i + width
            parts: str[] = []
            closed: bool = false
            while i < core.len(text):
                if text[i] == quote && (not triple || i + 2 < core.len(text) && text[i + 1] == quote && text[i + 2] == quote):
                    closed = true
                    break
                if text[i] == 10:
                    if not triple:
                        diagnostics.die("unterminated " + literal_name + " at line " + str(start_line))
                    line = line + 1
                if text[i] == 92:
                    i = i + 1
                    if i == core.len(text):
                        diagnostics.die("unterminated " + literal_name + " at line " + str(start_line))
                    escaped: uint8 = text[i]
                    if escaped == 110:
                        core.append(parts, "\n")
                    elif escaped == 114:
                        core.append(parts, "\r")
                    elif escaped == 116:
                        core.append(parts, "\t")
                    elif escaped == 48:
                        core.append(parts, "\0")
                    elif escaped == 92 || escaped == 34 || escaped == 39:
                        core.append(parts, core.slice(text, i, i + 1))
                    else:
                        diagnostics.die("unsupported " + literal_name + " escape at line " + str(line))
                else:
                    core.append(parts, core.slice(text, i, i + 1))
                i = i + 1
            if not closed:
                diagnostics.die("unterminated " + literal_name + " at line " + str(start_line))
            i = i + width
            decoded: str = core.join(parts)
            if literal_kind == 8 && core.len(decoded) != 1:
                diagnostics.die("byte literal must contain exactly one byte at line " + str(start_line))
            tokens.add(decoded, literal_kind, start_line)
        else:
            punct: str = core.slice(text, i, i + 1)
            if i + 1 < core.len(text):
                pair: str = core.slice(text, i, i + 2)
                if pair == "->" || pair == "==" || pair == "!=" || pair == "<=" || pair == ">=" || pair == "<<" || pair == ">>" || pair == "&&" || pair == "||" || pair == "+=":
                    punct = pair
            if punct == "(" || punct == "[":
                nesting = nesting + 1
            elif punct == ")" || punct == "]":
                nesting = nesting - 1
                if nesting < 0:
                    diagnostics.die("unmatched closing delimiter")
            tokens.add(punct, 7, line)
            i = i + core.len(punct)

    # Close the final line and indentation levels before ending the stream.
    if nesting != 0:
        diagnostics.die("unclosed delimiter")
    if core.len(tokens.kind) > 0 && tokens.kind[core.len(tokens.kind) - 1] != 4 && tokens.kind[core.len(tokens.kind) - 1] != 6:
        tokens.add("<newline>", 4, line)
    k: int64 = core.len(levels) - 1
    while k > 0:
        tokens.add("<dedent>", 6, line)
        k = k - 1
    tokens.add("<end>", 0, line)
    return tokens
