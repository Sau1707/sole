import core


# Store token text, kinds, source locations, and the parser cursor.
struct Tokens:
    text: str[]
    kind: int32[]
    line: int64[]
    position: int64[]
    files: str[]


def add(tokens: Tokens, text: str, kind: int32, line: int64) -> void:
    """Append a token and its source location to shared storage."""
    core.append(tokens.text, text)
    core.append(tokens.kind, kind)
    core.append(tokens.line, line)
    core.append(tokens.files, "")
