import core


# Store token text, kinds, source locations, and the parser cursor.
class Tokens:
    text: str[]
    kind: int32[]
    line: int64[]
    position: int64
    files: str[]

    def add(self, text: str, kind: int32, line: int64) -> void:
        """TODO: Document this function."""
        core.append(self.text, text)
        core.append(self.kind, kind)
        core.append(self.line, line)
        core.append(self.files, "")
