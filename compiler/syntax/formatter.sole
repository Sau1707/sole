import core


struct Lines:
    starts: int64[]
    kinds: int32[]
    bodies: int64[]
    error: str


def scan(source: str) -> Lines:
    """Scan physical lines, lexical context, and function body locations."""
    lines: Lines = Lines([], [], [], "")
    quote: uint8 = 0
    triple: bool = false
    delimiters: uint8[] = []
    depth: int64 = 0
    function_header: bool = false
    pending_body: bool = false
    function_indent: int64 = 0
    i: int64 = 0
    while i < core.len(source):
        start: int64 = i
        end: int64 = i
        while end < core.len(source) && source[end] != 10:
            end = end + 1
        core.append(lines.starts, start)
        first: int64 = start
        while first < end && (source[first] == 32 || source[first] == 9 || source[first] == 13):
            first = first + 1
        kind: int32 = 2
        if quote == 0 && first == end:
            kind = 0
        if quote == 0 && first < end && source[first] == 35:
            kind = 6
            if depth == 0 && first == start:
                kind = 1
        if quote == 0 && depth == 0:
            if first < end && source[first] != 35:
                if pending_body:
                    if first - start > function_indent:
                        core.append(lines.bodies, core.len(lines.kinds))
                    pending_body = false
                if first + 3 < end && core.slice(source, first, first + 3) == "def" && (source[first + 3] == 32 || source[first + 3] == 9):
                    function_header = true
                    function_indent = first - start
            if first == end:
                kind = 0
            elif source[first] == 35:
                if first == start:
                    kind = 1
            elif first == start:
                kind = 5
                word_end: int64 = first
                while word_end < end && source[word_end] >= 97 && source[word_end] <= 122:
                    word_end = word_end + 1
                word: str = core.slice(source, first, word_end)
                if word == "import" || word == "from":
                    kind = 3
                elif word == "def" || word == "struct" || word == "extern":
                    kind = 4
        core.append(lines.kinds, kind)
        while i < end:
            byte: uint8 = source[i]
            if quote != 0:
                if byte == 92:
                    i = i + 2
                    continue
                if byte == quote:
                    if not triple:
                        quote = 0
                    elif i + 2 < end && source[i + 1] == quote && source[i + 2] == quote:
                        quote = 0
                        i = i + 2
            elif byte == 35:
                break
            elif byte == 34 || byte == 39:
                quote = byte
                triple = i + 2 < end && source[i + 1] == byte && source[i + 2] == byte
                if triple:
                    i = i + 2
            elif byte == 40 || byte == 91:
                if depth == core.len(delimiters):
                    core.append(delimiters, byte)
                else:
                    delimiters[depth] = byte
                depth = depth + 1
            elif byte == 41 || byte == 93:
                if depth == 0:
                    lines.error = "unmatched closing delimiter"
                    return lines
                opening: uint8 = delimiters[depth - 1]
                if byte == 41 && opening != 40 || byte == 93 && opening != 91:
                    lines.error = "mismatched closing delimiter"
                    return lines
                depth = depth - 1
            elif byte == 58 && depth == 0 && function_header:
                function_header = false
                pending_body = true
            i = i + 1
        if quote != 0 && not triple:
            lines.error = "unterminated string"
            return lines
        i = end
        if i < core.len(source):
            i = i + 1
    if quote != 0:
        lines.error = "unterminated triple-quoted string"
    elif depth != 0:
        lines.error = "unclosed delimiter"
    return lines


def import_length(text: str) -> int64:
    """Measure an import without trailing whitespace or its inline comment."""
    end: int64 = 0
    while end < core.len(text) && text[end] != 35:
        end = end + 1
    while end > 0 && (text[end - 1] == 32 || text[end - 1] == 9):
        end = end - 1
    return end


def sort_imports(source: str, lines: Lines) -> str:
    """Stably sort each adjacent import group by statement length."""
    parts: str[] = []
    copied: int64 = 0
    i: int64 = 0
    while i < core.len(lines.kinds):
        if lines.kinds[i] != 3:
            i = i + 1
            continue
        first: int64 = i
        imports: str[] = []
        lengths: int64[] = []
        endings: str[] = []
        while i < core.len(lines.kinds) && lines.kinds[i] == 3:
            end: int64 = core.len(source)
            if i + 1 < core.len(lines.starts):
                end = lines.starts[i + 1]
            content_end: int64 = end
            if content_end > lines.starts[i] && source[content_end - 1] == 10:
                content_end = content_end - 1
                if content_end > lines.starts[i] && source[content_end - 1] == 13:
                    content_end = content_end - 1
            text: str = core.slice(source, lines.starts[i], content_end)
            length: int64 = import_length(text)
            core.append(endings, core.slice(source, content_end, end))
            core.append(imports, text)
            core.append(lengths, length)
            position: int64 = core.len(imports) - 1
            while position > 0 && lengths[position - 1] > length:
                imports[position] = imports[position - 1]
                lengths[position] = lengths[position - 1]
                position = position - 1
            imports[position] = text
            lengths[position] = length
            i = i + 1
        core.append(parts, core.slice(source, copied, lines.starts[first]))
        for j in range(core.len(imports)):
            core.append(parts, imports[j])
            core.append(parts, endings[j])
        copied = core.len(source)
        if i < core.len(lines.starts):
            copied = lines.starts[i]
    core.append(parts, core.slice(source, copied, core.len(source)))
    return core.join(parts)


def add_docstrings(source: str, lines: Lines, newline: str) -> str:
    """Insert TODO docstrings using each function body's indentation."""
    parts: str[] = []
    copied: int64 = 0
    for i in range(core.len(lines.bodies)):
        start: int64 = lines.starts[lines.bodies[i]]
        first: int64 = start
        while first < core.len(source) && (source[first] == 32 || source[first] == 9):
            first = first + 1
        if source[first] != 34 && source[first] != 39:
            core.append(parts, core.slice(source, copied, start))
            core.append(parts, core.slice(source, start, first) + "\"\"\"TODO: Document this function.\"\"\"" + newline)
            copied = start
    core.append(parts, core.slice(source, copied, core.len(source)))
    return core.join(parts)


def space_comments(source: str, lines: Lines, newline: str) -> str:
    """Ensure every standalone comment has a preceding blank line."""
    parts: str[] = []
    copied: int64 = 0
    for i in range(core.len(lines.kinds)):
        if lines.kinds[i] == 1 || lines.kinds[i] == 6:
            if i == 0 || lines.kinds[i - 1] != 0:
                core.append(parts, core.slice(source, copied, lines.starts[i]))
                core.append(parts, newline)
                copied = lines.starts[i]
    core.append(parts, core.slice(source, copied, core.len(source)))
    return core.join(parts)


def format_spacing(source: str, lines: Lines, newline: str) -> str:
    """Normalize spacing around top-level declarations and import groups."""
    parts: str[] = []
    copied: int64 = 0
    previous: int32 = 0
    for i in range(core.len(lines.kinds)):
        kind: int32 = lines.kinds[i]
        if kind >= 3 && kind <= 5:
            required: bool = previous == 3 || previous == 4 || kind == 4 && previous != 0
            if previous == 3 && kind == 3:
                required = false
            if required:
                anchor: int64 = i
                cursor: int64 = i
                while cursor > 0 && (lines.kinds[cursor - 1] == 1 || lines.kinds[cursor - 1] == 0):
                    cursor = cursor - 1
                    if lines.kinds[cursor] == 1:
                        anchor = cursor
                start: int64 = anchor
                while start > 0 && lines.kinds[start - 1] == 0:
                    start = start - 1
                if anchor - start != 2:
                    core.append(parts, core.slice(source, copied, lines.starts[start]))
                    core.append(parts, newline + newline)
                    copied = lines.starts[anchor]
            previous = kind
    core.append(parts, core.slice(source, copied, core.len(source)))
    return core.join(parts)


def format_source(source: str, lines: Lines) -> str:
    """Format imports, declaration spacing, docstrings, and comments."""
    newline: str = "\n"
    for i in range(1, core.len(source)):
        if source[i - 1] == 13 && source[i] == 10:
            newline = "\r\n"
            break
    formatted: str = add_docstrings(source, lines, newline)
    formatted = space_comments(formatted, scan(formatted), newline)
    formatted = format_spacing(formatted, scan(formatted), newline)
    return sort_imports(formatted, scan(formatted))
