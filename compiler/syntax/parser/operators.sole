# Rank binary operators for precedence-based expression parsing.
def precedence(operator: str) -> int32:
    if operator == "||":
        return 1
    if operator == "&&":
        return 2
    if operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">=":
        return 3
    if operator == "|":
        return 4
    if operator == "^":
        return 5
    if operator == "&":
        return 6
    if operator == "<<" || operator == ">>":
        return 7
    if operator == "+" || operator == "-":
        return 8
    if operator == "*" || operator == "/" || operator == "%":
        return 9
    return -1
