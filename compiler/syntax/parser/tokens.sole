import codegen.llvm.context as context
import diagnostics.report as diagnostics


def peek(state: context.State) -> str:
    """Inspect the next token without treating literal contents as syntax."""
    if state.tokens.kind[state.tokens.position] == 8:
        return "<byte>"
    if state.tokens.kind[state.tokens.position] == 3:
        return "<string>"
    if state.tokens.kind[state.tokens.position] == 2:
        return "<number>"
    return state.tokens.text[state.tokens.position]


def take(state: context.State) -> str:
    """Consume the next token, rejecting unexpected end of input."""
    value: str = state.tokens.text[state.tokens.position]
    if state.tokens.kind[state.tokens.position] == 0:
        diagnostics.fail_at(state, "unexpected end of input")
    state.tokens.position = state.tokens.position + 1
    return value


def accept(state: context.State, text: str) -> bool:
    """Consume a token only when it matches the requested syntax."""
    if peek(state) == text:
        take(state)
        return true
    return false


def expect(state: context.State, text: str) -> void:
    """Require a matching token or report a syntax error."""
    if not accept(state, text):
        diagnostics.fail_at(state, "expected '" + text + "', got '" + peek(state) + "'")


def skip_docstring(state: context.State) -> void:
    """Skip an optional docstring at the start of a block."""
    if state.tokens.kind[state.tokens.position] == 3 && state.tokens.kind[state.tokens.position + 1] == 4:
        take(state)
        take(state)


def reserved_keyword(name: str) -> bool:
    """Identify keywords that cannot be used as names."""
    return name == "def" || name == "extern" || name == "import" || name == "class" || name == "struct" || name == "enum" || name == "union" || name == "match" || name == "case" || name == "if" || name == "elif" || name == "else" || name == "while" || name == "return" || name == "break" || name == "continue" || name == "pass" || name == "not" || name == "true" || name == "false" || name == "self" || name == "as" || name == "from" || name == "intrinsic" || name == "for" || name == "in" || name == "lambda" || name == "None" || name == "True" || name == "False"


def identifier(state: context.State) -> str:
    """Read an identifier and reject reserved keywords."""
    if state.tokens.kind[state.tokens.position] != 1:
        diagnostics.fail_at(state, "expected an identifier")
    name: str = take(state)
    if reserved_keyword(name):
        diagnostics.fail_at(state, "reserved keyword: " + name)
    return name
